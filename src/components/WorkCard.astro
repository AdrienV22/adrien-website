---
type Props = {
  href: string;
  title: string;
  publishDate: Date;
  tags: string[];
  excerpt: string;
};

const { href, title, publishDate, tags, excerpt } = Astro.props;
---

<article class="card">
  <header class="head">
    <h3 class="title">
      <a class="titleLink" href={href}>{title}</a>
    </h3>

    <time class="date" datetime={publishDate.toISOString()}>
      {publishDate.toLocaleDateString("fr-FR")}
    </time>
  </header>

  <p class="excerpt">{excerpt}</p>

  <ul class="tags" aria-label="Tags">
    {tags.map((t) => <li class="tag">{t}</li>)}
  </ul>

  <a class="read" href={href} aria-label={`Lire le projet : ${title}`}>
    Lire le projet <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--gray-800);
    border-radius: 1.25rem;
    padding: 1.25rem;
    display: grid;
    gap: 0.75rem;

    /* ✅ fond dark cohérent */
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    color: var(--gray-100);

    transition:
      transform var(--theme-transition),
      box-shadow var(--theme-transition),
      border-color var(--theme-transition),
      background-color var(--theme-transition);
  }

  /* Hover "pro" */
  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-overlay);
    background: var(--gray-999_60, var(--gray-999_40));
  }

  .head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }

  .title {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.2;
    color: var(--gray-0);
  }

  .titleLink {
    text-decoration: none;
    color: inherit;
  }

  .titleLink:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--accent-overlay);
  }

  /* Focus visible (important pour accessibilité/jury) */
  .titleLink:focus-visible,
  .read:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
    border-radius: 0.75rem;
  }

  .date {
    font-size: var(--text-sm);
    color: var(--gray-400);
    white-space: nowrap;
  }

  .excerpt {
    margin: 0;
    color: var(--gray-300);
    line-height: 1.5;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    border: 1px solid var(--gray-800);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    color: var(--gray-100);

    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: var(--text-xs);
    line-height: 1.2;
  }

  .read {
    font-size: var(--text-sm);
    color: var(--accent-text-over);
    text-decoration: none;
    align-self: flex-start;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-subtle-overlay);
    border: 1px solid transparent;
    transition:
      background-color var(--theme-transition),
      border-color var(--theme-transition);
  }

  .read:hover {
    border-color: var(--accent-overlay);
    background: var(--accent-subtle-overlay);
    text-decoration: none;
  }
</style>
