---
import { slugifyTag } from "../lib/tags";

type Props = {
  href: string;
  title: string;
  tags: string[];
  excerpt: string;
  image?: string;
  imageAlt?: string;
};

const { href, title, tags, excerpt, image, imageAlt = "" } =
  Astro.props as Props;

// Catégorisation simple (tu peux enrichir quand tu veux)
const getTagCategory = (raw: string) => {
  const t = raw.trim().toLowerCase();

  // Frontend
  if (
    [
      "javascript",
      "js",
      "typescript",
      "ts",
      "react",
      "react.js",
      "astro",
      "html",
      "html5",
      "css",
      "css3",
    ].includes(t) || t.includes("frontend")
  )
    return "frontend";

  // Backend
  if (
    [
      "node",
      "node.js",
      "express",
      "java",
      "spring",
      "spring boot",
      "django",
      "php",
    ].includes(t) || t.includes("backend")
  )
    return "backend";

  // Data
  if (["sql", "postgresql", "mysql", "mongodb", "database", "db"].includes(t))
    return "data";

  // Tooling
  if (
    ["git", "github", "docker", "uipath", "ssis", "power bi", "jira", "trello", "figma"].includes(t)
  )
    return "tooling";

  // Cloud
  if (["aws", "azure", "gcp", "netlify"].includes(t)) return "cloud";

  return "other";
};
---

<article class="card">
  <!-- lien overlay : toute la card cliquable (sans imbriquer des <a>) -->
  <a class="cardLink" href={href} aria-label={`Ouvrir le projet : ${title}`}></a>

  {image && (
    <div class="media">
      <img
        src={image}
        alt={imageAlt || `Aperçu du projet ${title}`}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <header class="head">
    <h3 class="title">{title}</h3>
  </header>

  <p class="excerpt clamp">{excerpt}</p>

  <ul class="tags" aria-label="Tags">
    {tags.map((t) => (
      <li class="tag" data-cat={getTagCategory(t)}>
        <a
          class="tagLink"
          href={`/skills/${slugifyTag(t)}/`}
          aria-label={`Voir les projets liés à ${t}`}
        >
          {t}
        </a>
      </li>
    ))}
  </ul>

  <div class="read" aria-hidden="true">
    Lire le projet <span>→</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    border: 1px solid var(--gray-800);
    border-radius: 1.25rem;
    overflow: hidden;

    padding: 1.25rem;
    display: grid;
    gap: 0.75rem;

    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    color: var(--gray-100);

    transition:
      transform var(--theme-transition),
      box-shadow var(--theme-transition),
      border-color var(--theme-transition),
      background-color var(--theme-transition);
  }

  /* Hover sobre + élégant */
  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-overlay);
  }

  /* lien overlay */
  .cardLink {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }

  /* focus accessible */
  .cardLink:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
  }

  /* contenu au-dessus de l'overlay */
  .media,
  .head,
  .excerpt,
  .tags,
  .read {
    position: relative;
    z-index: 1;
  }

  /* Image */
  .media {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--gray-800);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
  }

  /* Surcouche gradient pour lisibilité */
  .media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55),
      rgba(0, 0, 0, 0.25) 35%,
      rgba(0, 0, 0, 0) 70%
    );
  }

  .media img {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    transform: scale(1);
    transition: transform var(--theme-transition);
  }

  .card:hover .media img {
    transform: scale(1.02);
  }

  .head {
    display: flex;
    align-items: baseline;
  }

  .title {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.2;
    color: var(--gray-0);
  }

  .excerpt {
    margin: 0;
    color: var(--gray-300);
    line-height: 1.5;
  }

  .clamp {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  /* ===== Tags (premium + safe) ===== */
  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;

    position: relative;
    z-index: 2; /* au-dessus de l'overlay */
  }

  /* ✅ les tags restent cliquables même avec l'overlay */
  .tag,
  .tagLink {
    pointer-events: auto;
  }

  .tag[data-cat="frontend"] {
    --tag-tint: rgba(120, 170, 255, 0.18);
  }
  .tag[data-cat="backend"] {
    --tag-tint: rgba(160, 140, 255, 0.18);
  }
  .tag[data-cat="tooling"] {
    --tag-tint: rgba(255, 200, 120, 0.16);
  }
  .tag[data-cat="data"] {
    --tag-tint: rgba(120, 255, 210, 0.16);
  }
  .tag[data-cat="cloud"] {
    --tag-tint: rgba(180, 220, 255, 0.16);
  }
  .tag[data-cat="other"] {
    --tag-tint: rgba(255, 255, 255, 0.12);
  }

  .tag {
    border: 1px solid var(--gray-800);
    border-radius: 999px;
    overflow: hidden;

    background:
      radial-gradient(var(--gray-900), var(--gray-800) 150%),
      linear-gradient(180deg, var(--tag-tint), transparent);

    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);

    transition:
      box-shadow var(--theme-transition),
      transform var(--theme-transition),
      border-color var(--theme-transition);
  }

  .tag:hover {
    transform: translateY(-1px);
    border-color: var(--accent-overlay);
    box-shadow:
      0 4px 14px rgba(0, 0, 0, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .tagLink {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    /* centrage optique */
    padding: 0.32rem 0.75rem;

    font-size: var(--text-xs);
    line-height: 1; /* ✅ évite le décalage vertical */
    color: var(--gray-200);
    text-decoration: none;

    position: relative;
    border-radius: 999px;

    transition:
      color var(--theme-transition),
      background-color var(--theme-transition);
  }

  /* underline subtil */
  .tagLink::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.22rem;
    height: 1px;

    background: currentColor;
    opacity: 0;
    transform: translateY(2px);

    transition:
      opacity var(--theme-transition),
      transform var(--theme-transition);
  }

  .tagLink:hover {
    color: var(--gray-0);
    background: var(--accent-subtle-overlay);
  }

  .tagLink:hover::after {
    opacity: 0.28;
    transform: translateY(0);
  }

  .tagLink:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 2px;
  }
</style>
