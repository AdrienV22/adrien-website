---
type Props = {
  variant?: "solid" | "subtle";
  class?: string;
};

const { variant = "solid", class: className = "" } = Astro.props as Props;
---

<div class={`pill pill--${variant} ${className}`}>
  <slot />
</div>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    gap: 0.5rem;
    border-radius: 999rem;
    font-size: var(--text-md);
    line-height: 1.35;
    white-space: nowrap;
  }

  /* Par défaut : ton style actuel */
  .pill--solid {
    color: var(--accent-text-over);
    border: 1px solid var(--accent-regular);
    background-color: var(--accent-regular);
  }

  /* Variante plus légère : parfaite pour les titres (catégories) */
  .pill--subtle {
    color: var(--accent-regular);
    border: 1px solid var(--accent-overlay);
    background: color-mix(in srgb, var(--accent-regular) 12%, transparent);
  }
</style>
