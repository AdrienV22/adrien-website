---
interface Props {
	variant?: "offset" | "small";
}

const { variant } = Astro.props;
---

<ul class:list={["grid", { offset: variant === "offset", small: variant === "small" }]}>
	<slot />
</ul>

<style>
	.grid {
		display: grid;
		/* MPORTANT : évite les hauteurs forcées qui cassent le mobile */
		grid-auto-rows: auto;

		gap: 1rem;
		list-style: none;
		padding: 0;
		margin: 0;

		/* mobile-first : 1 colonne */
		grid-template-columns: 1fr;
	}

	/* Variante "small" : reste 2 colonnes seulement si l'écran le permet */
	@media (min-width: 40em) {
		.grid.small {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
		}

		/* If last row contains only one item, make it span both columns. */
		.grid.small > :global(:last-child:nth-child(odd)) {
			grid-column: 1 / 3;
		}
	}

	@media (min-width: 50em) {
		.grid {
			grid-template-columns: 1fr 1fr;
			/* gap plus raisonnable (4rem peut sembler "cassé" sur certaines pages) */
			gap: 2rem;
		}

		.grid.offset {
			--row-offset: 7.5rem;
			padding-bottom: var(--row-offset);
		}

		/* Shift first item in each row vertically to create staggered effect. */
		.grid.offset > :global(:nth-child(odd)) {
			transform: translateY(var(--row-offset));
		}

		/* If last row contains only one item, display it in the second column. */
		.grid.offset > :global(:last-child:nth-child(odd)) {
			grid-column: 2 / 3;
			transform: none;
		}

		/* Variante small : ton comportement existant (flex wrap) conservé */
		.grid.small {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 2rem;
		}

		.grid.small > :global(*) {
			flex-basis: 20rem;
		}
	}
</style>
