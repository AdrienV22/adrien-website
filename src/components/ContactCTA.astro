---
import CallToAction from "./CallToAction.astro";
import Icon from "./Icon.astro";
---

<aside>
  <h2>Vous souhaitez me contacter ? <Icon icon="contact-logo" /></h2>

  <CallToAction href="mailto:adrien.valo@outlook.fr">
    Me contacter par mail
    <Icon icon="paper-plane-tilt" size="1.2em" />
  </CallToAction>
</aside>

<style>
  aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;

    padding: 5rem 1.5rem;
    border-top: 1px solid hsla(var(--gray-999-basis), 0.08);
    border-bottom: 1px solid hsla(var(--gray-999-basis), 0.08);

    /* Fond légèrement translucide et doux */
    background: linear-gradient(
      180deg,
      hsla(var(--gray-999-basis), 0.5),
      hsla(var(--gray-999-basis), 0.3)
    );
    backdrop-filter: blur(6px);

    /* Ombre premium */
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    border-radius: 1rem;
  }

  h2 {
    font-size: var(--text-xl);
    text-align: center;
    max-width: 15ch;
  }

  /* CTA dans le thème "pill" */
  :global(.cta-pill) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    padding: 0.6rem 1.15rem;
    border-radius: 999px;

    background: var(--accent-regular);
    border: 1px solid var(--accent-regular);
    color: var(--accent-text-over);

    text-decoration: none;
    font-size: var(--text-md);
    line-height: 1.35;
    white-space: nowrap;

    transition:
      transform var(--theme-transition),
      box-shadow var(--theme-transition),
      background-color var(--theme-transition),
      border-color var(--theme-transition);
  }

  :global(.cta-pill:hover),
  :global(.cta-pill:focus-visible) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
    border-color: var(--accent-overlay);
    outline: none;
  }

  @media (min-width: 50em) {
    aside {
      padding: 7.5rem;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    h2 {
      font-size: var(--text-3xl);
      text-align: left;
    }
  }

  /* CTA – style pill cohérent avec le site */
aside :global(a) {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;

  padding: 0.6rem 1.15rem;
  border-radius: 999px;

  background: var(--accent-regular);
  border: 1px solid var(--accent-regular);
  color: var(--accent-text-over);

  text-decoration: none;
  font-size: var(--text-md);
  line-height: 1.35;
  white-space: nowrap;

  transition:
    transform var(--theme-transition),
    box-shadow var(--theme-transition),
    background-color var(--theme-transition),
    border-color var(--theme-transition);
}

aside :global(a:hover),
aside :global(a:focus-visible) {
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
  border-color: var(--accent-overlay);
  outline: none;
}

</style>
