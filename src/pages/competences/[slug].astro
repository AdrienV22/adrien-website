---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import WorkCard from "../../components/WorkCard.astro";

type SkillEntry = CollectionEntry<"skills">;
type WorkEntry = CollectionEntry<"work">;

export async function getStaticPaths() {
  const entries = (await getCollection("skills")) as SkillEntry[];

  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = { entry: SkillEntry };
const { entry } = Astro.props as Props;
const d = entry.data;

/* ✅ Rend le Markdown en HTML (au lieu d'injecter entry.body brut) */
const { Content } = await entry.render();

// Typage local des preuves
type Evidence = {
  title: string;
  context?: string;
  result?: string;
  link?: string;
};

const evidence = (d.evidence ?? []) as Evidence[];

const typeLabel =
  d.type === "technique" ? "Compétence technique" : "Compétence humaine";

/* =========================
   Réalisations associées (relatedWorks)
========================= */
const workEntries = (await getCollection("work")) as WorkEntry[];
const relatedSlugs = (d.relatedWorks ?? []) as string[];

const workBySlug = new Map<string, WorkEntry>(
  workEntries.map((w) => [String(w.slug), w])
);

const relatedWorksAll = relatedSlugs
  .map((s) => workBySlug.get(String(s)))
  .filter((x): x is WorkEntry => Boolean(x));

// Limite pour garder la page légère sur mobile
const relatedWorks = relatedWorksAll.slice(0, 2);

function getExcerpt(markdown: string, length = 220) {
  const clean = markdown
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/<\/?[^>]+>/g, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#>*_`]/g, "")
    .replace(/\s+/g, " ")
    .trim();

  return clean.length > length ? clean.slice(0, length).trimEnd() + "…" : clean;
}
---

<BaseLayout title={`${d.title} | Compétences`} description={d.summary}>
  <main class="wrapper stack gap-10">
    <a class="back" href="/competences/">← Retour aux compétences</a>

    <Hero
      title={d.title}
      tagline={`${typeLabel} • Niveau ${d.level}/10`}
      align="start"
    />

    <section class="card">
      <header class="head">
        <p class="summary">{d.summary}</p>

        <div class="meter" aria-label={`Niveau ${d.level} sur 10`}>
          <span class="meterLabel">Niveau</span>
          <span class="meterValue">{d.level}/10</span>
          <div class="meterBar" aria-hidden="true">
            <span style={`width:${Math.min(100, (d.level / 10) * 100)}%`}></span>
          </div>
        </div>
      </header>

      {/* ✅ Markdown libre rendu correctement */}
      <article class="content">
        <Content />
      </article>

      {/* Preuves structurées */}
      {evidence.length ? (
        <section class="evidence" aria-label="Éléments de preuve">
          <h2>Éléments de preuve</h2>
          <ul class="evidenceList">
            {evidence.map((ev: Evidence) => (
              <li class="evidenceItem">
                <h3>{ev.title}</h3>
                {ev.context ? <p class="muted">{ev.context}</p> : null}
                {ev.result ? <p>{ev.result}</p> : null}
                {ev.link ? (
                  <p class="linkRow">
                    <a class="link" href={ev.link}>Voir le lien</a>
                  </p>
                ) : null}
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      {/* Auto-évaluation */}
      {d.selfCritique ? (
        <section class="block" aria-label="Auto-évaluation">
          <h2>Auto-évaluation</h2>
          <p>{d.selfCritique}</p>
        </section>
      ) : null}

      {/* Évolution */}
      {d.growth?.length ? (
        <section class="block" aria-label="Axes de progression">
          <h2>Évolution</h2>
          <ul class="list">
            {d.growth.map((g: string) => (
              <li>{g}</li>
            ))}
          </ul>
        </section>
      ) : null}

      {/* ✅ Exigence RNCP : réalisations rattachées + liens */}
      {relatedWorksAll.length ? (
        <section class="related" aria-label="Réalisations associées">
          <div class="relatedHead">
            <h2>Réalisations associées</h2>
            <a class="seeAll" href="/work/">Voir tous les projets</a>
          </div>
      
          <ul class="workGrid">
            {relatedWorks.map((w) => {
              const description = String((w.data as any).description ?? w.body ?? "");
              const excerpt = getExcerpt(description, 220);
      
              return (
                <li class="workGridItem">
                  <WorkCard
                    href={`/work/${w.slug}/`}
                    title={w.data.title as any}
                    tags={(w.data as any).tags ?? []}
                    excerpt={excerpt}
                    image={(w.data as any).img}
                    imageAlt={(w.data as any).img_alt}
                  />
                </li>
              );
            })}
          </ul>
        </section>
      ) : null}
      
    </section>
  </main>
</BaseLayout>

<style>
  .back {
    width: fit-content;
    color: var(--gray-300);
    text-decoration: none;
    border: 1px solid var(--gray-800);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    background: var(--gray-999_40);
    transition: border-color var(--theme-transition), transform var(--theme-transition);
  }
  .back:hover,
  .back:focus-visible {
    border-color: var(--gray-600);
    transform: translateY(-1px);
    outline: none;
  }

  .card {
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 3vw, 1.9rem);
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }

  .head {
    display: grid;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--gray-800);
    min-width: 0;
  }

  .summary {
    margin: 0;
    color: var(--gray-200);
    line-height: 1.7;
    max-width: 80ch;
    overflow-wrap: anywhere;
  }

  .meter {
    display: grid;
    gap: 0.4rem;
    max-width: 420px;
  }

  .meterLabel {
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  .meterValue {
    color: var(--gray-0);
    font-weight: 500;
  }

  .meterBar {
    height: 8px;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--gray-800) 70%, transparent);
  }

  .meterBar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: color-mix(in srgb, var(--accent-regular) 70%, var(--gray-700));
  }

  /* Markdown */
  .content {
    max-width: 78ch;
    min-width: 0;
  }

  .content :global(h2) {
    margin: 1.75rem 0 0.75rem;
    font-size: var(--text-xl);
    color: var(--gray-0);
    overflow-wrap: anywhere;
  }

  .content :global(p) {
    margin: 0.65rem 0;
    line-height: 1.75;
    color: var(--gray-200);
    overflow-wrap: anywhere;
  }

  .content :global(ul) {
    margin: 0.6rem 0 1rem;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    color: var(--gray-200);
  }

  .content :global(li) {
    position: relative;
    padding-left: 1rem;
    line-height: 1.7;
  }

  .content :global(li)::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--gray-400);
  }

  /* ✅ Bonus premium : rendu des séparateurs Markdown (---) */
  .content :global(hr) {
    border: 0;
    height: 1px;
    margin: 1.75rem 0;
    background: color-mix(in srgb, var(--gray-800) 85%, transparent);
  }

  .evidence {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gray-800);
  }

  .evidence h2,
  .block h2,
  .related h2 {
    margin: 0 0 0.75rem;
    font-size: var(--text-lg);
    color: var(--gray-0);
  }

  .evidenceList {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  .evidenceItem {
    border: 1px solid var(--gray-800);
    border-radius: 1.25rem;
    padding: 1rem 1.1rem;
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    min-width: 0;
  }

  .evidenceItem h3 {
    margin: 0 0 0.35rem;
    color: var(--gray-0);
    font-size: var(--text-md);
    overflow-wrap: anywhere;
  }

  .evidenceItem p {
    margin: 0.35rem 0 0;
    color: var(--gray-200);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .muted {
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  .linkRow {
    margin-top: 0.65rem;
  }

  .link {
    color: var(--gray-0);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }
  .link:hover,
  .link:focus {
    text-decoration-color: currentColor;
  }

  .block {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gray-800);
    max-width: 78ch;
    min-width: 0;
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: grid;
    gap: 0.45rem;
    color: var(--gray-200);
  }

  .list li {
    position: relative;
    padding-left: 1rem;
    line-height: 1.7;
  }

  .list li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--gray-400);
  }

  /* ✅ Réalisations associées */
  .related {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gray-800);
    min-width: 0;
  }

  .relatedHead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    min-width: 0;
  }

  .seeAll {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--gray-800);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    color: var(--gray-200);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: transform var(--theme-transition), border-color var(--theme-transition);
  }

  .seeAll::after {
    content: "›";
    opacity: 0.85;
    transform: translateY(-0.5px);
  }

  .seeAll:hover,
  .seeAll:focus-visible {
    transform: translateY(-1px);
    border-color: var(--gray-600);
    outline: none;
  }

  /* même logique que /work */
  .workGrid {
    list-style: none;
    padding: 0;
    margin: 0;

    display: grid;
    gap: 1.5rem;

    grid-template-columns: 1fr; /* mobile-first */
    min-width: 0;
  }

  @media (min-width: 40em) {
    .workGrid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  .workGridItem {
    margin: 0;
    min-width: 0;
  }

  .smallNote {
    margin-top: 0.85rem;
  }
</style>
