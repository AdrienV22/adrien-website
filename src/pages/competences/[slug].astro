---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import WorkCard from "../../components/WorkCard.astro";

type SkillEntry = CollectionEntry<"skills">;
type WorkEntry = CollectionEntry<"work">;
type ParcoursEntry = CollectionEntry<"parcours">;

export async function getStaticPaths() {
  const entries = (await getCollection("skills")) as SkillEntry[];

  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = { entry: SkillEntry };
const { entry } = Astro.props as Props;
const d = entry.data;

/* ✅ Rend le Markdown en HTML (au lieu d'injecter entry.body brut) */
const { Content } = await entry.render();

// Typage local des preuves
type Evidence = {
  title: string;
  context?: string;
  result?: string;
  link?: string;
};

const evidence = (d.evidence ?? []) as Evidence[];

const typeLabel =
  d.type === "technique" ? "Compétence technique" : "Compétence humaine";

/* =========================
   Réalisations associées (relatedWorks) / Parcours associés (relatedParcours)
========================= */
const workEntries = (await getCollection("work")) as WorkEntry[];
const parcoursEntries = (await getCollection("parcours")) as ParcoursEntry[];
const skillEntries = await getCollection("skills");
const skillBySlug = new Map(skillEntries.map((s) => [String(s.slug), s]));

function getSkillPills(relatedSlugs: string[]): { title: string; slug: string }[] {
  return relatedSlugs
    .map((slug) => skillBySlug.get(String(slug)))
    .filter((s): s is import("astro:content").CollectionEntry<"skills"> => Boolean(s))
    .map((s) => ({ title: s.data.title, slug: s.slug }));
}

const relatedSlugs = (d.relatedWorks ?? []) as string[];
const workBySlug = new Map<string, WorkEntry>(
  workEntries.map((w) => [String(w.slug), w])
);

const relatedWorksAll = relatedSlugs
  .map((s) => workBySlug.get(String(s)))
  .filter((x): x is WorkEntry => Boolean(x));

const relatedWorks = relatedWorksAll;

const relatedParcoursSlugs = ((d as { relatedParcours?: string[] }).relatedParcours ?? []) as string[];
const parcoursBySlug = new Map<string, ParcoursEntry>(
  parcoursEntries.map((p) => [String(p.slug), p])
);
const relatedParcoursAll = relatedParcoursSlugs
  .map((s) => parcoursBySlug.get(String(s)))
  .filter((x): x is ParcoursEntry => Boolean(x));

function getExcerpt(markdown: string, length = 220) {
  const clean = markdown
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/<\/?[^>]+>/g, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#>*_`]/g, "")
    .replace(/\s+/g, " ")
    .trim();

  return clean.length > length ? clean.slice(0, length).trimEnd() + "…" : clean;
}
---

<BaseLayout title={`${d.title} | Compétences`} description={d.summary}>
  <main class="wrapper stack gap-10">
    <a class="back" href="/competences/">← Retour aux compétences</a>

    <Hero
      title={d.title}
      tagline={`${typeLabel} • Niveau ${d.level}/10`}
      align="start"
    />

    <section class="card">
      <header class="head">
        <p class="summary">{d.summary}</p>

        <div class="meter" aria-label={`Niveau ${d.level} sur 10`}>
          <span class="meterLabel">Niveau</span>
          <span class="meterValue">{d.level}/10</span>
          <div class="meterBar" aria-hidden="true">
            <span style={`width:${Math.min(100, (d.level / 10) * 100)}%`}></span>
          </div>
        </div>
      </header>

      {/* ✅ Markdown libre : même rendu bloc que fiches projets (data-md-blocks + script) */}
      <article class="content" data-md-blocks>
        <Content />
      </article>

      {/* Preuves structurées */}
      {evidence.length ? (
        <section class="evidence" aria-label="Éléments de preuve">
          <h2>Éléments de preuve</h2>
          <ul class="evidenceList">
            {evidence.map((ev: Evidence) => (
              <li class="evidenceItem">
                <h3>{ev.title}</h3>
                {ev.context ? <p class="muted">{ev.context}</p> : null}
                {ev.result ? <p>{ev.result}</p> : null}
                {ev.link ? (
                  <p class="linkRow">
                    <a class="link" href={ev.link}>Voir la réalisation</a>
                  </p>
                ) : null}
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      {/* Mon autocritique */}
      {d.selfCritique ? (
        <section class="block" aria-label="Mon autocritique">
          <h2>Mon autocritique</h2>
          <p>{d.selfCritique}</p>
        </section>
      ) : null}

      {/* Évolution */}
      {d.growth?.length ? (
        <section class="block" aria-label="Axes de progression">
          <h2>Évolution</h2>
          <ul class="list">
            {d.growth.map((g: string) => (
              <li>{g}</li>
            ))}
          </ul>
        </section>
      ) : null}

      {/* ✅ Parcours associés (ex. compétence interculturelle) ou Réalisations associées */}
      {relatedParcoursAll.length ? (
        <section class="related" aria-label="Parcours associés">
          <div class="relatedHead">
            <h2>Parcours associés</h2>
            <a class="seeAll" href="/parcours/">Voir tout le parcours</a>
          </div>
          <ul class="workGrid parcoursGrid">
            {relatedParcoursAll.map((p) => {
              const pd = p.data;
              const label = pd.role ?? pd.title;
              const typeLabel = pd.type === "experience" ? "Expérience" : pd.type === "formation" ? "Formation" : "Certification";
              return (
                <li class="workGridItem">
                  <a class="parcoursCard" href={`/parcours/${p.slug}/`}>
                    {pd.logo ? (
                      <div class="parcoursCardLogo">
                        <img src={pd.logo} alt="" loading="lazy" decoding="async" />
                      </div>
                    ) : null}
                    <div class="parcoursCardBody">
                      <span class="parcoursCardBadge">{typeLabel}</span>
                      <h3 class="parcoursCardTitle">{label}</h3>
                      <p class="parcoursCardOrg">{pd.organization}</p>
                      <p class="parcoursCardPeriod">{pd.period}</p>
                      {pd.highlight ? <p class="parcoursCardHighlight">{pd.highlight}</p> : null}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ) : relatedWorksAll.length ? (
        <section class="related" aria-label="Réalisations associées">
          <div class="relatedHead">
            <h2>Réalisations associées</h2>
            <a class="seeAll" href="/projets/">Voir tous les projets</a>
          </div>
          <ul class="workGrid">
            {relatedWorks.map((w) => {
              const description = String((w.data as any).description ?? w.body ?? "");
              const excerpt = getExcerpt(description, 220);
              const skillPills = getSkillPills((w.data as any).relatedSkills ?? []);
              return (
                <li class="workGridItem">
                  <WorkCard
                    href={`/projets/${w.slug}/`}
                    title={w.data.title as any}
                    tags={(w.data as any).tags ?? []}
                    skillPills={skillPills}
                    cardBadge={(w.data as any).cardBadge}
                    excerpt={excerpt}
                    image={(w.data as any).img}
                    imageAlt={(w.data as any).img_alt}
                  />
                </li>
              );
            })}
          </ul>
        </section>
      ) : null}
      
    </section>
  </main>
</BaseLayout>

<script>
  (() => {
    const root = document.querySelector("[data-md-blocks]");
    if (!root) return;

    const icons = {
      target: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
      tools: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 7l3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M13 8l-8 8a2 2 0 0 0 0 3 2 2 0 0 0 3 0l8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M16.5 3.5a4.5 4.5 0 0 0 4 6l-1.8 1.8-4-4L16.5 3.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>`,
      check: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M8 12l3 3 5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
      arrow: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17l10-10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M10 7h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    };

    type IconKey = keyof typeof icons;
    const iconMap = new Map<string, IconKey>([
      ["definition", "target"],
      ["definition et contexte professionnel", "target"],
      ["mise en pratique", "tools"],
      ["auto-evaluation", "check"],
      ["auto-évaluation", "check"],
      ["mon autocritique", "check"],
      ["evolution", "arrow"],
      ["évolution", "arrow"],
    ]);

    const normalize = (s: string) =>
      String(s)
        .trim()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

    const children = Array.from(root.children);
    let current: HTMLElement | null = null;

    for (const el of children) {
      const isH2 = el.tagName === "H2";
      if (isH2) {
        current = document.createElement("article");
        current.className = "block mdBlock";
        root.insertBefore(current, el);
        const title = el.textContent ?? "";
        const key = normalize(title);
        const iconKey = iconMap.get(key);
        if (iconKey) {
          const iconWrap = document.createElement("span");
          iconWrap.className = "blockIcon";
          iconWrap.setAttribute("aria-hidden", "true");
          iconWrap.innerHTML = icons[iconKey];
          el.prepend(iconWrap);
        }
        current.appendChild(el);
        continue;
      }
      if (current) current.appendChild(el);
    }
  })();
</script>

<style>
  .back {
    width: fit-content;
    color: var(--gray-300);
    text-decoration: none;
    border: 1px solid var(--gray-800);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    background: var(--gray-999_40);
    transition: border-color var(--theme-transition), transform var(--theme-transition);
  }
  .back:hover,
  .back:focus-visible {
    border-color: var(--gray-600);
    transform: translateY(-1px);
    outline: none;
  }

  .card {
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 3vw, 1.9rem);
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }

  .head {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--gray-800);
    min-width: 0;
  }

  /* Résumé mis en avant (premium) */
  .summary {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    font-weight: 450;
    line-height: 1.65;
    color: var(--gray-100);
    max-width: 78ch;
    overflow-wrap: anywhere;
    border-radius: clamp(0.75rem, 1.5vw, 1rem);
    border-left: 3px solid color-mix(in srgb, var(--accent-regular) 60%, var(--gray-700));
    background: color-mix(in srgb, var(--accent-regular) 6%, var(--gray-999_40));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--gray-800) 50%, transparent);
  }

  .meter {
    display: grid;
    gap: 0.4rem;
    max-width: 420px;
  }

  .meterLabel {
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  .meterValue {
    color: var(--gray-0);
    font-weight: 500;
  }

  .meterBar {
    height: 8px;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--gray-800) 70%, transparent);
  }

  .meterBar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: color-mix(in srgb, var(--accent-regular) 70%, var(--gray-700));
  }

  /* Contenu markdown : mêmes blocs que fiches projets, largeur adaptée (pas de bande vide) */
  .content {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    max-width: min(88ch, 100%);
    min-width: 0;
  }

  .content :global(.mdBlock) {
    position: relative;
    border: 1px solid var(--gray-800);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform var(--theme-transition),
      box-shadow var(--theme-transition),
      border-color var(--theme-transition);
  }

  .content :global(.mdBlock::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 14%;
    bottom: 14%;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 18%,
      var(--accent-regular) 50%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 82%,
      transparent 100%
    );
    opacity: 0.7;
  }

  .content :global(.mdBlock:hover),
  .content :global(.mdBlock:focus-within) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-overlay);
    outline: none;
  }

  .content :global(.mdBlock > h2) {
    margin: 0 0 0.75rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    letter-spacing: -0.02em;
    color: var(--gray-0);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Sous-titres (ex. preuves) : toujours plus petits que le h2 de section */
  .content :global(.mdBlock h3) {
    margin: 1rem 0 0.5rem;
    font-size: var(--text-md);
    letter-spacing: -0.01em;
    color: var(--gray-0);
  }
  .content :global(.mdBlock h3:first-of-type) {
    margin-top: 0.5rem;
  }

  .content :global(.blockIcon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    color: color-mix(in srgb, var(--accent-regular) 55%, var(--gray-200));
    opacity: 0.95;
    transform: translateY(0.5px);
  }

  .content :global(.blockIcon svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .content :global(.mdBlock:hover .blockIcon),
  .content :global(.mdBlock:focus-within .blockIcon) {
    color: var(--accent-regular);
  }

  .content :global(.mdBlock p) {
    margin: 0.65rem 0;
    line-height: 1.75;
    color: var(--gray-200);
  }

  .content :global(.mdBlock ul),
  .content :global(.mdBlock ol) {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.55rem;
    color: var(--gray-200);
  }

  .content :global(.mdBlock li) {
    position: relative;
    padding-left: 1rem;
    line-height: 1.7;
  }

  .content :global(.mdBlock li::before) {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--gray-400);
  }

  .content :global(hr) {
    border: 0;
    height: 1px;
    margin: 1.75rem 0;
    background: color-mix(in srgb, var(--gray-800) 85%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .content :global(.mdBlock) {
      transition: none;
    }
  }

  /* Sections structurées : même style bloc que fiches projets */
  .evidence {
    margin-top: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--gray-800);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .evidence::before {
    content: "";
    position: absolute;
    left: 0;
    top: 14%;
    bottom: 14%;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 18%,
      var(--accent-regular) 50%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 82%,
      transparent 100%
    );
    opacity: 0.7;
  }

  .evidence h2,
  .block h2,
  .related h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    letter-spacing: -0.02em;
    color: var(--gray-0);
  }

  .evidenceList {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  .evidenceItem {
    border: 1px solid var(--gray-800);
    border-radius: 1rem;
    padding: 1rem 1.1rem;
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    min-width: 0;
  }

  .evidenceItem h3 {
    margin: 0 0 0.35rem;
    color: var(--gray-0);
    font-size: var(--text-md);
    overflow-wrap: anywhere;
  }

  .evidenceItem p {
    margin: 0.35rem 0 0;
    color: var(--gray-200);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .muted {
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  .linkRow {
    margin-top: 0.65rem;
  }

  .link {
    color: var(--gray-0);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }
  .link:hover,
  .link:focus {
    text-decoration-color: currentColor;
  }

  .block {
    margin-top: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--gray-800);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
    max-width: 78ch;
    min-width: 0;
  }

  .block::before {
    content: "";
    position: absolute;
    left: 0;
    top: 14%;
    bottom: 14%;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 18%,
      var(--accent-regular) 50%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 82%,
      transparent 100%
    );
    opacity: 0.7;
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: grid;
    gap: 0.45rem;
    color: var(--gray-200);
  }

  .list li {
    position: relative;
    padding-left: 1rem;
    line-height: 1.7;
  }

  .list li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--gray-400);
  }

  /* ✅ Réalisations associées : même cohérence bloc */
  .related {
    margin-top: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--gray-800);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
    min-width: 0;
  }

  .related::before {
    content: "";
    position: absolute;
    left: 0;
    top: 14%;
    bottom: 14%;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 18%,
      var(--accent-regular) 50%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 82%,
      transparent 100%
    );
    opacity: 0.7;
  }

  .relatedHead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    min-width: 0;
  }

  .seeAll {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--gray-800);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    color: var(--gray-200);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: transform var(--theme-transition), border-color var(--theme-transition);
  }

  .seeAll::after {
    content: "›";
    opacity: 0.85;
    transform: translateY(-0.5px);
  }

  .seeAll:hover,
  .seeAll:focus-visible {
    transform: translateY(-1px);
    border-color: var(--gray-600);
    outline: none;
  }

  /* même logique que /work */
  .workGrid {
    list-style: none;
    padding: 0;
    margin: 0;

    display: grid;
    gap: 1.5rem;

    grid-template-columns: 1fr; /* mobile-first */
    min-width: 0;
  }

  @media (min-width: 40em) {
    .workGrid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  /* Réalisations associées : cartes plus compactes, plusieurs par ligne */
  .related .workGrid {
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }

  @media (min-width: 30em) {
    .related .workGrid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 280px));
    }
  }

  @media (min-width: 50em) {
    .related .workGrid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 300px));
    }
  }

  .workGridItem {
    margin: 0;
    min-width: 0;
  }

  /* Parcours associés : cards uniformes et premium */
  .parcoursGrid {
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    align-items: stretch;
  }

  .parcoursGrid .workGridItem {
    display: flex;
    min-height: 0;
  }

  .parcoursCard {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
