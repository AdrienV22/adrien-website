---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Grid from "../../components/Grid.astro";
import SkillCard from "../../components/SkillCard.astro";

const skills = await getCollection("skills");

const technicalSkills = skills
  .filter((s) => s.data.type === "technique")
  .sort((a, b) => b.data.level - a.data.level);

const softSkills = skills
  .filter((s) => s.data.type === "humaine")
  .sort((a, b) => b.data.level - a.data.level);
---

<BaseLayout title="Compétences">
  <main class="wrapper stack gap-16">
    <header class="hero">
      <div class="heroInner">
        <div class="heroText">
          <h1>Compétences</h1>
          <p class="lead">
            Compétences techniques et humaines, illustrées par des preuves concrètes et une auto-analyse.
          </p>
        </div>

        <aside class="methodCard" aria-label="Méthode d’évaluation">
          <h2 class="methodTitle">Méthode d’évaluation</h2>

          <ul class="methodList">
            <li>
              <span class="dash" aria-hidden="true">–</span>
              <span><strong>Niveau 1–10</strong> basé sur la pratique en projet.</span>
            </li>
            <li>
              <span class="dash" aria-hidden="true">–</span>
              <span>Chaque compétence comporte des <strong>preuves</strong> et une <strong>auto-analyse</strong>.</span>
            </li>
            <li>
              <span class="dash" aria-hidden="true">–</span>
              <span>Un <strong>axe de progression</strong> explicite est indiqué pour rester crédible.</span>
            </li>
          </ul>
        </aside>
      </div>
    </header>

    <div class="split" aria-label="Compétences techniques et humaines">
      <section class="skills-section" aria-label="Compétences techniques">
        <div class="section-head">
          <h2>
            Compétences techniques <span class="count">({technicalSkills.length})</span>
          </h2>          
          <p>Conception, développement, qualité et industrialisation.</p>
        </div>

        <Grid>
          {technicalSkills.map((entry) => (
            <li class="gridItem">
              <SkillCard entry={entry} />
            </li>
          ))}
        </Grid>
      </section>

      <section class="skills-section" aria-label="Compétences humaines">
        <div class="section-head">
          <h2>
            Compétences humaines <span class="count">({softSkills.length})</span>
          </h2>          
          <p>Collaboration, communication, organisation et posture professionnelle.</p>
        </div>

        <Grid>
          {softSkills.map((entry) => (
            <li class="gridItem">
              <SkillCard entry={entry} />
            </li>
          ))}
        </Grid>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 0.25rem;
  }

  .heroInner {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  .heroText h1 {
    margin: 0;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0.75rem 0 0;
    max-width: 70ch;
    color: var(--gray-200);
    line-height: 1.7;
  }

  .methodCard {
    border: 1px solid var(--gray-800);
    border-radius: 1.25rem;
    padding: 1.25rem;
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }

  .methodTitle {
    margin: 0 0 0.75rem;
    font-size: var(--text-lg);
    color: var(--gray-0);
  }

  .methodList {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
    color: var(--gray-200);
  }

  .methodList li {
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: 0.35rem;
    line-height: 1.65;
    min-width: 0;
  }

  .dash {
    color: var(--gray-400);
  }

  @media (min-width: 55em) {
    .heroInner {
      grid-template-columns: 1.2fr 0.9fr;
      gap: 1.5rem;
    }
  }

  .split {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }

  @media (min-width: 60em) {
    .split {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 2.25rem;
    }

    .skills-section {
      margin-top: 0;
    }
  }

  .skills-section {
    margin-top: 1.75rem;
    min-width: 0;
  }

  .section-head {
    margin-bottom: 1rem;
    min-width: 0;
  }

  .section-head h2 {
    margin: 0;
    color: var(--gray-0);
    overflow-wrap: anywhere;
  }

  .section-head p {
    margin: 0.35rem 0 0;
    color: var(--gray-400);
    line-height: 1.6;
    max-width: 80ch;
    overflow-wrap: anywhere;
  }

  /* ✅ UL Grid item wrapper : évite les débordements sur mobile */
  .gridItem {
    min-width: 0;
  }

  @media (max-width: 25em) { /* 400px */
    .methodCard {
      padding: 1rem;
    }

    .methodList li {
      grid-template-columns: 0.8rem 1fr;
      gap: 0.3rem;
    }

    .lead {
      margin-top: 0.6rem;
    }

    .split {
      gap: 1.5rem;
    }
  }

  .hero,
  .heroInner,
  .heroText {
    min-width: 0;
  }

  .hero * {
    overflow-wrap: anywhere;
  }

  .count {
  color: var(--gray-400);
  font-weight: 500;
  font-size: 0.95em;
  letter-spacing: 0.01em;
}

</style>
