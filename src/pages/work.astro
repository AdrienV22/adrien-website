---
import { getCollection } from "astro:content";
import WorkCard from "../components/WorkCard.astro";

import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";

const entries = await getCollection("work");

function getExcerpt(markdown: string, length = 220) {
  const clean = markdown
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/<\/?[^>]+>/g, "")
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#>*_`]/g, "")
    .replace(/\s+/g, " ")
    .trim();

  return clean.length > length ? clean.slice(0, length).trimEnd() + "…" : clean;
}

const projects = entries
  .map((entry) => ({
    href: `/work/${entry.slug}/`,
    excerpt: getExcerpt((entry.data as any).description ?? entry.body),
    ...entry.data,
    image: (entry.data as any).img,
    imageAlt: (entry.data as any).img_alt,
  }))
  .sort((a, b) => b.publishDate.valueOf() - a.publishDate.valueOf());

const featured = projects.slice(0, 5);
const others = projects.slice(5);
---

<BaseLayout
  title="Réalisations | Adrien Valo"
  description="Sélection de réalisations (projets) illustrant mes compétences et ma progression."
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-14">
      <header class="hero">
        <Hero
          title="Réalisations"
          tagline="Une sélection de projets concrets, avec résultats observables et liens vers le détail."
          align="start"
        />
      </header>

      <section class="section" aria-label="Réalisations principales">
        <div class="sectionHead">
          <h2 class="sectionTitle">
            <span class="sectionTitleText">Réalisations principales</span>
            <span class="count" aria-label={`${featured.length} réalisations principales`}>
              ({featured.length})
            </span>
          </h2>
        </div>

        <ul class="workGrid">
          {featured.map((project) => (
            <li class="workGridItem">
              <WorkCard
                href={project.href}
                title={project.title}
                tags={project.tags}
                excerpt={project.excerpt}
                image={project.image}
                imageAlt={project.imageAlt}
              />
            </li>
          ))}
        </ul>
      </section>

      {others.length ? (
        <section class="section section--secondary" aria-label="Autres projets">
          <div class="sectionHead">
            <h2 class="sectionTitle">
              <span class="sectionTitleText">Autres projets</span>
              <span class="count" aria-label={`${others.length} autres projets`}>
                ({others.length})
              </span>
            </h2>
          </div>

          <ul class="workGrid">
            {others.map((project) => (
              <li class="workGridItem">
                <WorkCard
                  href={project.href}
                  title={project.title}
                  tags={project.tags}
                  excerpt={project.excerpt}
                  image={project.image}
                  imageAlt={project.imageAlt}
                />
              </li>
            ))}
          </ul>
        </section>
      ) : null}
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.25rem;
  }

  .section {
    margin-top: 0.25rem;
  }

  .sectionHead {
    margin-bottom: 1.1rem;
    min-width: 0;
  }

  /* Titre + compteur : wrap propre et stable */
  .sectionTitle {
    margin: 0;
    color: var(--gray-0);

    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;

    line-height: 1.2;
    min-width: 0;
  }

  .sectionTitleText {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* Compteur : ne se retrouve jamais seul sur une ligne */
  .count {
    color: var(--gray-400);
    font-weight: 500;
    font-size: 0.95em;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  /* Option premium : meilleure césure sur navigateurs récents */
  @supports (text-wrap: balance) {
    .sectionTitleText {
      text-wrap: balance;
    }
  }

  /* Si tu réactives un sous-texte plus tard */
  .sectionHead p {
    margin: 0.35rem 0 0;
    color: var(--gray-400);
    line-height: 1.6;
    max-width: 85ch;
  }

  .workGrid {
    list-style: none;
    padding: 0;
    margin: 0;

    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 40em) {
    .workGrid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  .workGridItem {
    margin: 0;
    min-width: 0;
  }

  .section--secondary {
    margin-top: 6.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--gray-800);
  }

  @media (min-width: 50em) {
    .section--secondary {
      margin-top: 7.5rem;
    }
  }

  /* Sécurité très petits écrans : évite un titre trop massif */
  @media (max-width: 24em) {
    .sectionTitle {
      font-size: var(--text-2xl);
    }
  }
</style>
