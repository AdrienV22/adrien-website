---
import { getCollection } from "astro:content";
import WorkCard from "../components/WorkCard.astro";

import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";

const entries = await getCollection("work");

function getExcerpt(markdown: string, length = 220) {
  const clean = markdown
    .replace(/!\[.*?\]\(.*?\)/g, "") // images
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") // liens -> texte
    .replace(/[#>*_`]/g, "") // markdown simple
    .replace(/\s+/g, " ")
    .trim();

  return clean.length > length ? clean.slice(0, length).trimEnd() + "…" : clean;
}

const projects = entries
  .map((entry) => ({
    href: `/work/${entry.slug}/`,
    excerpt: getExcerpt(entry.body),
    ...entry.data,
  }))
  .sort((a, b) => b.publishDate.valueOf() - a.publishDate.valueOf());
---

<BaseLayout
  title="Mes projets | Adrien Valo"
  description="tous mes projets"
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero title="Tous mes projets" tagline="" align="start" />

      <Grid variant="offset">
        {
          projects.map((project) => (
            <li>
              <WorkCard
                href={project.href}
                title={project.title}
                publishDate={project.publishDate}
                tags={project.tags}
                excerpt={project.excerpt}
              />
            </li>
          ))
        }
      </Grid>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>
