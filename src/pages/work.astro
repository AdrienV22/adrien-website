---
import { getCollection } from "astro:content";
import WorkCard from "../components/WorkCard.astro";

import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";

const entries = await getCollection("work");

function getExcerpt(markdown: string, length = 220) {
  const clean = markdown
    .replace(/<!--[\s\S]*?-->/g, "") // commentaires HTML
    .replace(/<\/?[^>]+>/g, "") // balises HTML
    .replace(/!\[.*?\]\(.*?\)/g, "") // images markdown
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") // liens -> texte
    .replace(/[#>*_`]/g, "") // markdown simple
    .replace(/\s+/g, " ")
    .trim();

  return clean.length > length ? clean.slice(0, length).trimEnd() + "…" : clean;
}

const projects = entries
  .map((entry) => ({
    href: `/work/${entry.slug}/`,
    excerpt: getExcerpt((entry.data as any).description ?? entry.body),
    ...entry.data,
    image: (entry.data as any).img,
    imageAlt: (entry.data as any).img_alt,
  }))
  .sort((a, b) => b.publishDate.valueOf() - a.publishDate.valueOf());
---

<BaseLayout title="Mes projets | Adrien Valo" description="tous mes projets">
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero title="Tous mes projets" tagline="" align="start" />

      <ul class="workGrid">
        {projects.map((project) => (
          <li class="workGridItem">
            <WorkCard
              href={project.href}
              title={project.title}
              tags={project.tags}
              excerpt={project.excerpt}
              image={project.image}
              imageAlt={project.imageAlt}
            />
          </li>
        ))}
      </ul>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .workGrid {
    list-style: none;
    padding: 0;
    margin: 0;

    display: grid;
    gap: 1.5rem;

    /* Mobile-first */
    grid-template-columns: 1fr;
  }

  /* Tablette et + */
  @media (min-width: 40em) {
    .workGrid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  .workGridItem {
    margin: 0;
    min-width: 0;
  }
</style>
