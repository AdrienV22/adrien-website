---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ContactCTA from "../../components/ContactCTA.astro";

type ItemType = "experience" | "formation" | "certification";

const TYPE_LABEL: Record<ItemType, string> = {
  experience: "Expérience",
  formation: "Formation",
  certification: "Certification",
};

const TYPE_DETAIL_LABEL: Record<ItemType, string> = {
  experience: "Détail de l’expérience",
  formation: "Détail de la formation",
  certification: "Détail de la certification",
};

// 1) Récupération des entrées
const entries = await getCollection("parcours");

// 2) Tri anti-chronologique strict : startDate desc, puis endDate desc
const items = entries.sort((a, b) => {
  const aStart = a.data.startDate?.getTime?.() ?? 0;
  const bStart = b.data.startDate?.getTime?.() ?? 0;

  if (aStart !== bStart) return bStart - aStart;

  const aEnd = a.data.endDate?.getTime?.() ?? 0;
  const bEnd = b.data.endDate?.getTime?.() ?? 0;

  return bEnd - aEnd;
});
---

<BaseLayout
  title="Mon Parcours | Adrien Valo"
  description="Parcours académique et professionnel"
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-16">
      <Hero
        title="Mon Parcours"
        tagline="Une trajectoire entre reconversion, apprentissage et ouverture internationale."
        align="start"
      />

      <section class="timeline" aria-label="Parcours (chronologie)">
        {items.map((entry) => {
          const d = entry.data;
          const type = d.type as ItemType;

          return (
            <article class="timeline-item" data-type={type}>
              <div class="timeline-marker" aria-hidden="true"></div>

              <div class="timeline-content">
                <div class="topRow">
                  {d.logo ? (
                    <div class="logoWrap" aria-hidden="true">
                      <img src={d.logo} alt="" loading="lazy" decoding="async" />
                    </div>
                  ) : null}

                  <div class="main">
                    <div class="metaRow">
                      <span class="period">{d.period}</span>
                      <span class="badge">{TYPE_LABEL[type]}</span>
                    </div>

                    <h3 class="title">{d.role ?? d.title}</h3>

                    <p class="org">
                      {d.url ? (
                        <a href={d.url} target="_blank" rel="noopener">
                          {d.organization}
                        </a>
                      ) : (
                        d.organization
                      )}
                    </p>

                    {(d.location || d.mode || d.status) ? (
                      <p class="sub">
                        {d.status ? d.status : null}
                        {d.status && (d.location || d.mode) ? " • " : null}
                        {d.location ? d.location : null}
                        {d.location && d.mode ? " • " : null}
                        {d.mode ? d.mode : null}
                      </p>
                    ) : null}

                    {d.highlight ? <p class="highlight">{d.highlight}</p> : null}

                    <div class="actions">
                      <a class="detailLink" href={`/parcours/${entry.slug}/`}>
                        {TYPE_DETAIL_LABEL[type]}
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
.timeline {
  position: relative;
  margin-top: 6rem;
  padding-top: 0.95rem;
  padding-left: 2.25rem;

}

.timeline::before {
  content: "";
  position: absolute;
  left: 1.05rem; /* ajuste si besoin selon ton alignement */
  top: 0;
  bottom: 0;
  width: 2px;

  /* ligne élégante : dégradé + contraste doux */
  background: linear-gradient(
    to bottom,
    transparent 0%,
    color-mix(in srgb, var(--gray-800) 65%, var(--gray-600)) 12%,
    var(--gray-700) 50%,
    color-mix(in srgb, var(--gray-800) 65%, var(--gray-600)) 88%,
    transparent 100%
  );

  border-radius: 999px;
  opacity: 0.95;
}

/* glow subtil (premium, pas “néon”) */
.timeline::after {
  content: "";
  position: absolute;
  left: 1.05rem;
  top: 0;
  bottom: 0;
  width: 10px;
  transform: translateX(-4px);

  background: radial-gradient(
    closest-side,
    color-mix(in srgb, var(--accent-regular) 18%, transparent),
    transparent 70%
  );

  opacity: 0.35;
  pointer-events: none;
}




  .timeline-item {
  position: relative;
  margin-bottom: 2.25rem; /* légèrement plus compact */
  padding-left: 0.25rem;  /* petit équilibre visuel avec la ligne */
}

.timeline-item:hover .timeline-marker {
  background: var(--accent-overlay);
}

.timeline-item:hover ~ .timeline::after {
  opacity: 0.45;
}


/* améliore l'alignement vertical du marker */
.timeline-marker {
  top: 1.35rem; /* aligne avec la card plutôt qu’avec le texte brut */
}


  .timeline-content {
  border: 1px solid var(--gray-800);
  border-radius: 1.25rem;
  padding: 1.25rem;

  background: var(--gray-999_40);
  box-shadow: var(--shadow-sm);

  transition:
    transform var(--theme-transition),
    box-shadow var(--theme-transition),
    border-color var(--theme-transition);
}

.timeline-item:hover .timeline-content {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  border-color: var(--accent-overlay);
}


  .timeline-marker {
    display: none;
  }

  .topRow {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
  min-width: 0; /* ✅ évite le débordement */
}

.title,
.org,
.sub,
.highlight {
  min-width: 0; /* ✅ le texte peut se “rétrécir” sans casser */
  overflow-wrap: anywhere; /* ✅ pas de débordement */
}

.title {
  font-size: clamp(1.05rem, 2.4vw, 1.35rem);
  line-height: 1.25;
}

.org {
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;         
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.highlight {
  line-height: 1.55;
  max-width: 70ch;
}

.timeline-content {
  padding: clamp(1rem, 3.2vw, 1.35rem);
}

.main {
  gap: 0.4rem;
}

.actions {
  margin-top: 0.8rem;
}

.period {
  font-size: clamp(0.85rem, 2.2vw, 0.95rem);
  letter-spacing: 0.05em;
}



@media (max-width: 40em) {
  .topRow {
    flex-direction: column;
    gap: 0.75rem;
  }

  .logoWrap {
    margin-top: 0;
  }
}


  .logoWrap {
    width: 44px;
    height: 44px;
    border-radius: 0.9rem;
    overflow: hidden;

    border: 1px solid var(--gray-800);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    box-shadow: var(--shadow-sm);

    display: grid;
    place-items: center;
    flex: 0 0 auto;
    margin-top: 0.2rem;
  }

  .logoWrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    opacity: 0.95;
  }

  .main {
    min-width: 0;
    display: grid;
    gap: 0.45rem;
  }

  .metaRow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .period {
  font-size: 0.95rem;             
  font-weight: 700;
  text-transform: uppercase;      
  letter-spacing: 0.06em;
  color: var(--gray-100);
}



.timeline-item:hover .period {
  color: var(--gray-0);
}

.timeline-item:hover .period::before {
  opacity: 1;
}


  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;

    border: 1px solid var(--gray-800);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    color: var(--gray-200);

    font-size: var(--text-xs);
    line-height: 1;
  }

  .timeline-item[data-type="experience"] .badge {
  border-color: color-mix(in srgb, var(--accent-regular) 35%, var(--gray-800));
}

.timeline-item[data-type="formation"] .badge {
  border-color: color-mix(in srgb, var(--accent-regular) 22%, var(--gray-800));
}

.timeline-item[data-type="certification"] .badge {
  border-color: color-mix(in srgb, var(--accent-regular) 15%, var(--gray-800));
}


  .title {
    margin: 0.1rem 0 0;
    color: var(--gray-0);
  }

  .org {
    margin: 0;
    color: var(--gray-200);
  }

  .org :global(a) {
    color: inherit;
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .org :global(a:hover),
  .org :global(a:focus) {
    text-decoration-color: currentColor;
  }

  .sub {
    margin: 0;
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  .highlight {
    margin: 0.5rem 0 0;
    padding-left: 0.75rem;
    font-weight: 500;
    border-left: 2px solid var(--accent-regular);
    color: var(--gray-100);
  }

  .actions {
    margin-top: 0.95rem;
  }

  .detailLink {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;

    padding: 0.35rem 0.75rem;
    border-radius: 999px;

    border: 1px solid var(--gray-700);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    color: var(--gray-100);

    font-size: var(--text-sm);
    line-height: 1;
    text-decoration: none;

    transition:
      transform var(--theme-transition),
      box-shadow var(--theme-transition),
      border-color var(--theme-transition);
  }

  .detailLink::after {
    content: "›";
    transform: translateY(-0.5px);
    opacity: 0.85;
  }

  .detailLink:hover,
  .detailLink:focus-visible {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
    border-color: var(--gray-600);
    outline: none;
  }

  .timeline {
  list-style: none;
  margin: 0;
  padding-left: 2rem; /* on garde ton alignement frise */
}

.timeline-item {
  list-style: none;
}

.timeline-item::marker {
  content: none;
}

.timeline,
.timeline * {
  list-style: none;
}

.logoWrap {
  width: clamp(42px, 6vw, 48px);
  height: clamp(42px, 6vw, 48px);
  border-radius: 1rem;
  overflow: hidden;

  border: 1px solid var(--gray-800);
  background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
  display: grid;
  place-items: center;
  box-shadow: var(--shadow-sm);
}

.logoWrap img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  opacity: 0.95;
}


  @media (max-width: 30em) {
    .logoWrap {
      width: 38px;
      height: 38px;
      border-radius: 0.8rem;
    }
  }

  
</style>
