---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { slugifyTag, getSkillCategory } from "../../lib/tags";

const entries = await getCollection("work");

// 1) Récupère tous les tags, nettoie, déduplique
const tagSet = new Set<string>();
for (const entry of entries) {
  const tags = (entry.data as any).tags ?? [];
  for (const t of tags) {
    if (typeof t === "string" && t.trim()) tagSet.add(t.trim());
  }
}

// 2) Liste unique + tri
const allTags = Array.from(tagSet).sort((a, b) =>
  a.localeCompare(b, "fr", { sensitivity: "base" })
);

// 3) Groupement par catégories via getSkillCategory()
type CategoryKey = "language" | "technology" | "tool";

const grouped: Record<CategoryKey, string[]> = {
  language: [],
  technology: [],
  tool: [],
};

for (const tag of allTags) {
  const cat = getSkillCategory(tag);
  grouped[cat].push(tag);
}

// Tri dans chaque catégorie (lisible)
for (const key of Object.keys(grouped) as CategoryKey[]) {
  grouped[key].sort((a, b) => a.localeCompare(b, "fr", { sensitivity: "base" }));
}

// 4) Titres
const CATEGORY_TITLES: Record<CategoryKey, string> = {
  language: "Langages",
  technology: "Technologies",
  tool: "Outils",
};

const ORDER: CategoryKey[] = ["language", "technology", "tool"];
---

<BaseLayout
  title="Compétences | Adrien Valo"
  description="Technologies et compétences liées à mes projets"
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-10">
      <Hero
        title="Compétences"
        tagline="Technologies et compétences liées à mes projets."
        align="start"
      />

      <section class="skills stack gap-10" aria-label="Compétences par catégorie">
        {ORDER.map((key) =>
          grouped[key].length ? (
            <div class="skills-block stack gap-4">
              <header class="skills-header">
                <h2 class="skills-title">{CATEGORY_TITLES[key]}</h2>
              </header>

              <ul
                class="tagGrid"
                aria-label={`Liste des compétences : ${CATEGORY_TITLES[key]}`}
              >
                {grouped[key].map((tag) => {
                  const slug = slugifyTag(tag);
                  return (
                    <li>
                      <a class="chip" href={`/skills/${slug}/`}>
                        {tag}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ) : null
        )}
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .skills {
    display: grid;
    gap: 1rem;
  }

  .skills-header {
    display: flex;
    align-items: center;
  }

  .tagGrid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;

  border: 1px solid var(--gray-700);
  background: radial-gradient(
    var(--gray-900),
    var(--gray-800) 150%
  );
  color: var(--gray-100);

  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);

  text-decoration: none;

  transition:
    transform var(--theme-transition),
    box-shadow var(--theme-transition),
    border-color var(--theme-transition);
}



.chip:hover,
.chip:focus-visible {
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
  border-color: var(--gray-600);
  outline: none;
}


  .skills-header {
  display: flex;
  align-items: center;
}

.skills-title {
  margin: 0;
  font-size: var(--text-xl);
  letter-spacing: -0.02em;
  color: var(--gray-100);
}

/* Mode clair : renforcer la lisibilité des pills */
@media (prefers-color-scheme: light) {
  .chip {
    border-color: var(--black-900);
    background: radial-gradient(var(--gray-100), var(--gray-200) 160%);
    color: var(--black-900);
  }

  .chip:hover,
  .chip:focus-visible {
    border-color: var(--gray-600);
  }
}

</style>
