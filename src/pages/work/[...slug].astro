---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

import ContactCTA from "../../components/ContactCTA.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import Pill from "../../components/Pill.astro";

interface Props {
  entry: CollectionEntry<"work">;
}

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as Props;
const { Content, headings } = await entry.render();

// Sommaire : sections principales (h2) et sous-sections (h3)
const toc = (headings ?? []).filter((h: any) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="page stack gap-20">
    <div class="stack gap-15">
      <header class="header">
        <div class="wrapper stack gap-3">
          <a class="back-link" href="/work/">
            <Icon icon="arrow-left" /> Revenir à tous mes projets
          </a>

          <Hero title={entry.data.title} align="start">
            <div class="details">
              {entry.data.tags?.length ? (
                <div class="tags" aria-label="Tags du projet">
                  {entry.data.tags.map((t) => <Pill>{t}</Pill>)}
                </div>
              ) : null}

              <p class="description">{entry.data.description}</p>
            </div>
          </Hero>
        </div>
      </header>

      <main class="wrapper">
        <section class="project" aria-label="Contenu du projet">
          <article class="article stack gap-10">
            {entry.data.img ? (
              <figure class="cover">
                <img
                  src={entry.data.img}
                  alt={entry.data.img_alt || ""}
                  loading="lazy"
                />
              </figure>
            ) : null}

            <div class="md">
              <Content />
            </div>
          </article>

          <aside class="aside" aria-label="Informations projet">
            <div class="asideCard">
              <h2 class="asideTitle">Résumé</h2>
              <p class="asideText">{entry.data.description}</p>

              {entry.data.tags?.length ? (
                <>
                  <h3 class="asideSubtitle">Technologies</h3>
                  <div class="asideTags">
                    {entry.data.tags.map((t) => <Pill>{t}</Pill>)}
                  </div>
                </>
              ) : null}

              {toc.length ? (
                <>
                  <h3 class="asideSubtitle">Sommaire</h3>
                  <nav class="toc" aria-label="Sommaire">
                    <ol class="tocList">
                      {toc.map((h: any) => (
                        <li class:list={["tocItem", h.depth === 3 && "isSub"]}>
                          <a class="tocLink" href={`#${h.slug}`} data-toc-link>
                            {h.text}
                          </a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                </>
              ) : null}
            </div>
          </aside>
        </section>
      </main>
    </div>

    <ContactCTA />
  </div>

  {/* Scroll-spy : section active dans le sommaire */}
  <script is:inline>
    {`
      (() => {
        const links = Array.from(document.querySelectorAll('[data-toc-link]'));
        if (!links.length) return;

        const byId = new Map();
        for (const a of links) {
          const id = (a.getAttribute('href') || '').slice(1);
          if (!id) continue;
          const el = document.getElementById(id);
          if (el) byId.set(id, { a, el });
        }
        if (!byId.size) return;

        const setActive = (id) => {
          for (const { a } of byId.values()) a.removeAttribute('aria-current');
          const item = byId.get(id);
          if (item) item.a.setAttribute('aria-current', 'true');
        };

        links.forEach((a) => {
          a.addEventListener('click', () => {
            const id = (a.getAttribute('href') || '').slice(1);
            if (id) setActive(id);
          });
        });

        const obs = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => (b.intersectionRatio || 0) - (a.intersectionRatio || 0))[0];

            if (!visible) return;
            const id = visible.target.id;
            if (id) setActive(id);
          },
          {
            root: null,
            rootMargin: '-25% 0px -65% 0px',
            threshold: [0.15, 0.33, 0.5],
          }
        );

        for (const { el } of byId.values()) obs.observe(el);

        const initial = (location.hash || '').slice(1);
        if (initial && byId.has(initial)) setActive(initial);
      })();
    `}
  </script>

  {/* Actions flottantes : Réalisations + Retour en haut (anneau + halo) */}
  <div class="pageActions" aria-label="Navigation de fin de page">
    <a class="backToWork" href="/work/" aria-label="Revenir à la liste des réalisations">
      <span class="backToWorkIcon" aria-hidden="true">‹</span>
      Réalisations
    </a>

    <button
      class="backToTop"
      type="button"
      aria-label="Revenir en haut de la page"
      data-back-to-top
    >
      <svg class="ring" viewBox="0 0 44 44" aria-hidden="true">
        <circle class="ringTrack" cx="22" cy="22" r="18" />
        <circle class="ringProgress" cx="22" cy="22" r="18" />
      </svg>
      <span class="arrow" aria-hidden="true">↑</span>
    </button>
  </div>

  <script is:inline>
    {`
      (() => {
        const btn = document.querySelector('[data-back-to-top]');
        if (!btn) return;

        const progress = btn.querySelector('.ringProgress');
        const r = 18;
        const c = 2 * Math.PI * r;

        if (progress) {
          progress.style.strokeDasharray = String(c);
          progress.style.strokeDashoffset = String(c);
        }

        const clamp01 = (n) => Math.max(0, Math.min(1, n));

        const update = () => {
          const doc = document.documentElement;
          const scrollTop = doc.scrollTop || document.body.scrollTop || 0;
          const scrollHeight = doc.scrollHeight - doc.clientHeight;
          const ratio = scrollHeight > 0 ? clamp01(scrollTop / scrollHeight) : 0;

          if (progress) {
            progress.style.strokeDashoffset = String(c * (1 - ratio));
          }

          if (scrollTop > 400) {
            btn.classList.add('is-visible');
          } else {
            btn.classList.remove('is-visible');
          }
        };

        update();
        window.addEventListener('scroll', update, { passive: true });

        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    `}
  </script>
</BaseLayout>

<style>
  .header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--gray-800);
  }

  .back-link {
    display: none;
    width: fit-content;
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .back-link:hover,
  .back-link:focus {
    text-decoration-color: currentColor;
  }

  /* Header details */
  .details {
    display: grid;
    gap: 0.9rem;
    padding: 0.25rem 0;
    justify-items: start;
    text-align: left;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: flex-start;
  }

  .description {
    font-size: var(--text-lg);
    max-width: 62ch;
    margin: 0;
    color: var(--gray-200);
    line-height: 1.7;
  }

  /* Layout fiche projet */
  .project {
    display: grid;
    gap: 2rem;
    align-items: start;
    min-width: 0;
  }

  @media (min-width: 60em) {
    .project {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 2.75rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
  }

  /* Colonne contenu */
  .article {
    max-width: 92ch;
    margin: 0;
    min-width: 0;
  }

  /* Cover image */
  .cover {
    margin: 0;
  }

  .cover img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-sm);
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
  }

  /* Aside premium */
  .aside {
    min-width: 0;
  }

  .asideCard {
    border: 1px solid var(--gray-800);
    border-radius: 1.25rem;
    padding: 1rem 1.1rem;
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 60em) {
    .asideCard {
      position: sticky;
      top: 6.5rem;
    }
  }

  .asideTitle {
    margin: 0 0 0.5rem;
    font-size: var(--text-md);
    color: var(--gray-0);
  }

  .asideSubtitle {
    margin: 1rem 0 0.5rem;
    font-size: var(--text-sm);
    color: var(--gray-400);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .asideText {
    margin: 0;
    color: var(--gray-200);
    line-height: 1.7;
  }

  .asideTags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Sommaire */
  .toc {
    margin-top: 0.25rem;
  }

  .tocList {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }

  .tocItem {
    min-width: 0;
  }

  .tocItem.isSub {
    padding-left: 0.75rem;
  }

  .tocItem.isSub .tocLink::before {
    content: "–";
    margin-right: 0.5rem;
    color: var(--gray-400);
  }

  .tocLink {
    display: inline-block;
    color: var(--gray-200);
    text-decoration: none;
    line-height: 1.5;
    overflow-wrap: anywhere;
    border-left: 2px solid transparent;
    padding-left: 0.5rem;
    transition: border-color var(--theme-transition), color var(--theme-transition),
      transform var(--theme-transition);
  }

  .tocLink:hover,
  .tocLink:focus-visible {
    color: var(--gray-0);
    border-left-color: var(--gray-600);
    outline: none;
    transform: translateX(1px);
  }

  .tocLink[aria-current="true"] {
    color: var(--gray-0);
    border-left-color: var(--accent-regular);
  }

  /* Markdown */
  .md > :global(* + *) {
    margin-top: 1rem;
  }

  .md :global(h1),
  .md :global(h2),
  .md :global(h3),
  .md :global(h4),
  .md :global(h5) {
    margin: 1.6rem 0 0.8rem;
  }

  .md :global(p) {
    line-height: 1.75;
    color: var(--gray-200);
  }

  .md :global(ul),
  .md :global(ol) {
    padding-left: 1.2rem;
    color: var(--gray-200);
  }

  .md :global(li) {
    line-height: 1.75;
  }

  .md :global(hr) {
    border: 0;
    height: 1px;
    margin: 1.75rem 0;
    background: color-mix(in srgb, var(--gray-800) 85%, transparent);
  }

  .md :global(blockquote) {
    font-size: var(--text-lg);
    font-family: var(--font-brand);
    font-weight: 600;
    line-height: 1.2;
    padding-inline-start: 1.25rem;
    border-inline-start: 0.25rem solid var(--accent-dark);
    color: var(--gray-0);
    margin: 1.25rem 0;
  }

  .md :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .md :global(a:hover),
  .md :global(a:focus) {
    text-decoration-color: currentColor;
  }

  /* Actions flottantes */
  .pageActions {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .backToWork {
    display: none;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--gray-800);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    color: var(--gray-200);
    text-decoration: none;
    font-size: var(--text-sm);
    line-height: 1;
    transition: transform var(--theme-transition), border-color var(--theme-transition),
      color var(--theme-transition);
  }

  .backToWorkIcon {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 1px solid var(--gray-800);
    color: var(--gray-200);
    transform: translateY(-0.5px);
  }

  .backToWork:hover,
  .backToWork:focus-visible {
    transform: translateY(-1px);
    border-color: var(--gray-600);
    color: var(--gray-0);
    outline: none;
  }

  .backToWork:hover .backToWorkIcon,
  .backToWork:focus-visible .backToWorkIcon {
    border-color: var(--gray-600);
    color: var(--gray-0);
  }

  @media (min-width: 40em) {
    .backToWork {
      display: inline-flex;
    }
  }

  .backToTop {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid var(--gray-800);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    color: var(--gray-200);
    display: grid;
    place-items: center;
    cursor: pointer;

    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;

    transition: opacity var(--theme-transition), transform var(--theme-transition),
      border-color var(--theme-transition), color var(--theme-transition);
  }

  .backToTop::before {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: inherit;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent-regular) 26%, transparent),
      transparent 70%
    );
    opacity: 0;
    filter: blur(6px);
    transition: opacity var(--theme-transition);
    pointer-events: none;
  }

  .backToTop.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .backToTop:hover,
  .backToTop:focus-visible {
    border-color: var(--gray-600);
    color: var(--gray-0);
    outline: none;
  }

  .backToTop:hover::before,
  .backToTop:focus-visible::before {
    opacity: 1;
  }

  .arrow {
    position: relative;
    z-index: 2;
    font-size: 1.1rem;
    transform: translateY(-0.5px);
  }

  .ring {
    position: absolute;
    inset: 0;
    width: 46px;
    height: 46px;
    z-index: 1;
    transform: rotate(-90deg);
  }

  .ringTrack {
    fill: none;
    stroke: color-mix(in srgb, var(--gray-800) 75%, transparent);
    stroke-width: 3;
  }

  .ringProgress {
    fill: none;
    stroke: color-mix(in srgb, var(--accent-regular) 80%, var(--gray-700));
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 0;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.06s linear;
  }
</style>
