---
import { getCollection, getEntryBySlug, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import Icon from "../../components/Icon.astro";
import Pill from "../../components/Pill.astro";

type WorkEntry = CollectionEntry<"work">;
type SkillEntry = CollectionEntry<"skills">;

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({ params: { slug: entry.slug } }));
}

/** [...slug] => string OU string[] */
const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam;

if (!slug) throw new Error("Missing slug param for /work/[...slug].astro");

const entry = (await getEntryBySlug("work", slug)) as WorkEntry | null;
if (!entry) throw new Error(`Work entry not found for slug: ${slug}`);

const { Content, headings } = await entry.render();
const toc = (headings ?? []).filter((h: any) => h.depth >= 2 && h.depth <= 3);

const type = (entry.data as any)?.type as string | undefined;
const typeLabel =
  type === "projet" ? "Projet" :
  type === "etude" ? "Étude" :
  type === "rpa" ? "Automatisation" :
  type === "dev" ? "Développement" :
  type ? "Autre" : null;

const tagline = typeLabel ?? "";

const gallery = (entry.data as any)?.gallery as { src: string; alt?: string }[] | undefined;
const imgAlt = entry.data.img_alt || entry.data.title;

const altOf = (item: { alt?: string }, i: number) =>
  (item.alt && String(item.alt).trim()) || `${entry.data.title} — visuel ${i + 1}`;

/** RNCP : compétences liées (slug -> titre) */
const relatedSkillsSlugs = ((entry.data as any)?.relatedSkills ?? []) as string[];
const skills = (await getCollection("skills")) as SkillEntry[];
const skillBySlug = new Map(skills.map((s) => [String(s.slug), s]));
const relatedSkills = relatedSkillsSlugs
  .map((s) => skillBySlug.get(String(s)))
  .filter((x): x is SkillEntry => Boolean(x));
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <main class="wrapper stack gap-10">
    <a class="back" href="/work/">
      <Icon icon="arrow-left" /> Retour aux réalisations
    </a>

    <Hero title={entry.data.title} tagline={tagline || undefined} align="start">
      {entry.data.description ? <p class="lead">{entry.data.description}</p> : null}
    </Hero>

    <section class="layout" aria-label="Fiche projet">
      {/* Colonne principale */}
      <div class="mainCol stack gap-10">
        {gallery?.length ? (
          <section class="gallery" aria-label="Galerie">
            <div class="galleryViewport" tabindex="0" aria-label="Galerie (défilement horizontal)">
              {gallery.map((item, i) => (
                <figure class="gallerySlide">
                  <img
                    src={item.src}
                    alt={altOf(item, i)}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
          </section>
        ) : entry.data.img ? (
          <figure class="cover">
            <img src={entry.data.img} alt={imgAlt} loading="lazy" decoding="async" />
          </figure>
        ) : null}

        {/* ✅ Card principale “comme competences” */}
        <section class="card" aria-label="Contenu">
          <article class="content autoBlocks">
            <Content />
          </article>
        </section>
      </div>

      {/* Colonne droite */}
      <aside class="sideCol" aria-label="Informations">
        {/* Résumé */}
        <section class="card sideCard">
          <h2 class="sideTitle">Résumé</h2>

          {entry.data.description ? <p class="sideText">{entry.data.description}</p> : null}

          {typeLabel ? (
            <dl class="facts" aria-label="Fiche projet">
              <dt>Nature</dt>
              <dd>{typeLabel}</dd>
            </dl>
          ) : null}

          {entry.data.tags?.length ? (
            <>
              <h3 class="sideSubtitle">Technologies</h3>
              <div class="sideTags">
                {entry.data.tags.map((t) => <Pill>{t}</Pill>)}
              </div>
            </>
          ) : null}
        </section>

        {/* Compétences mobilisées */}
        {relatedSkills.length ? (
          <section class="card sideCard">
            <h2 class="sideTitle">Compétences mobilisées</h2>
            <div class="skillLinks">
              {relatedSkills.map((s) => (
                <a class="skillPill" href={`/competences/${s.slug}/`}>
                  {s.data.title}
                </a>
              ))}
            </div>
          </section>
        ) : null}

        {/* TOC premium sticky */}
        {toc.length ? (
          <section class="card sideCard tocCard">
            <h2 class="sideTitle">Table des matières</h2>
            <nav class="toc" aria-label="Table des matières">
              <ol class="tocList">
                {toc.map((h: any) => (
                  <li class:list={["tocItem", h.depth === 3 && "isSub"]}>
                    <a class="tocLink" href={`#${h.slug}`}>
                      <span class="tocText">{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </section>
        ) : null}

        <section class="sideActions" aria-label="Actions">
          <a class="pillLink" href="/work/">Toutes les réalisations</a>
          <a class="pillLink" href="#top">Retour en haut</a>
        </section>
      </aside>
    </section>

    <ContactCTA />
  </main>
</BaseLayout>

<style>
  .back {
    width: fit-content;
    color: var(--gray-300);
    text-decoration: none;
    border: 1px solid var(--gray-800);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    background: var(--gray-999_40);
    transition: border-color var(--theme-transition), transform var(--theme-transition);
  }
  .back:hover,
  .back:focus-visible {
    border-color: var(--gray-600);
    transform: translateY(-1px);
    outline: none;
  }

  .lead {
    margin: 0;
    max-width: 78ch;
    color: var(--gray-200);
    line-height: 1.7;
  }

  .layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    min-width: 0;
  }

  @media (min-width: 60em) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 360px;
    }
  }

  .mainCol,
  .sideCol {
    min-width: 0;
  }

  .sideCol {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .card {
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 3vw, 1.9rem);
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }

  .sideCard h2 {
    margin: 0 0 0.75rem;
    font-size: var(--text-lg);
    line-height: 1.2;
    color: var(--gray-0);
  }
  .sideCard h3 {
    margin: 1rem 0 0.5rem;
    font-size: var(--text-md);
    line-height: 1.25;
    color: var(--gray-0);
  }

  .sideText {
    margin: 0.5rem 0 0.75rem;
    color: var(--gray-200);
    line-height: 1.7;
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
  }

  .facts dt {
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  .facts dd {
    margin: 0;
    color: var(--gray-0);
  }

  .skillLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

/* =========================
   Skill pills — premium
========================= */

.skillLinks {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.skillPill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;

  padding: 0.42rem 0.8rem;
  border-radius: 999px;

  /* base "glass" */
  background:
    linear-gradient(180deg, var(--gray-999_40), transparent),
    radial-gradient(var(--gray-900), var(--gray-800) 150%);

  border: 1px solid color-mix(in srgb, var(--gray-800) 82%, transparent);

  color: var(--gray-100);
  text-decoration: none;
  font-size: var(--text-sm);
  line-height: 1;

  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.08),
    inset 0 0 0 1px rgba(255, 255, 255, 0.03);

  transition:
    transform var(--theme-transition),
    border-color var(--theme-transition),
    box-shadow var(--theme-transition),
    background var(--theme-transition);
}

/* petit chevron discret (premium, pas "button") */
.skillPill::after {
  content: "›";
  opacity: 0.75;
  transform: translateY(-0.5px);
  transition: transform var(--theme-transition), opacity var(--theme-transition);
}

/* hover élégant */
.skillPill:hover,
.skillPill:focus-visible {
  transform: translateY(-1px);
  outline: none;

  border-color: color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700));

  box-shadow:
    0 18px 45px rgba(0, 0, 0, 0.16),
    inset 0 0 0 1px rgba(255, 255, 255, 0.05);

  background:
    linear-gradient(180deg, color-mix(in srgb, var(--accent-overlay) 55%, transparent), transparent),
    radial-gradient(var(--gray-900), var(--gray-800) 150%);
}

.skillPill:hover::after,
.skillPill:focus-visible::after {
  opacity: 0.9;
  transform: translate(1px, -0.5px);
}

/* état "click" */
.skillPill:active {
  transform: translateY(0);
}

/* accessibilité : focus visible propre */
.skillPill:focus-visible {
  box-shadow:
    0 18px 45px rgba(0, 0, 0, 0.16),
    0 0 0 3px color-mix(in srgb, var(--accent-overlay) 35%, transparent),
    inset 0 0 0 1px rgba(255, 255, 255, 0.05);
}
  .tocCard {
    position: sticky;
    top: calc(var(--nav-gap) + 0.75rem);
  }

  .tocList {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }

  .tocItem.isSub .tocLink {
    padding-left: 1.25rem;
    opacity: 0.92;
  }

  .tocLink {
    display: flex;
    text-decoration: none;
    color: var(--gray-200);
    padding: 0.45rem 0.55rem;
    border-radius: 0.75rem;
    border: 1px solid transparent;
    transition: transform var(--theme-transition), border-color var(--theme-transition),
      background var(--theme-transition);
  }

  .tocLink:hover,
  .tocLink:focus-visible {
    outline: none;
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--gray-800) 85%, transparent);
    background: color-mix(in srgb, var(--gray-999_40) 70%, transparent);
  }

  .tocText {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 60em) {
    .tocCard {
      position: static;
      top: auto;
    }
    .tocText {
      white-space: normal;
    }
  }

  .content {
    max-width: 78ch;
    min-width: 0;
  }

  .content :global(h2) {
    margin: 1.75rem 0 0.75rem;
    font-size: var(--text-xl);
    color: var(--gray-0);
    overflow-wrap: anywhere;
  }

  .content :global(h3) {
    margin: 1.25rem 0 0.6rem;
    font-size: var(--text-lg);
    color: var(--gray-0);
  }

  .content :global(p) {
    margin: 0.65rem 0;
    line-height: 1.75;
    color: var(--gray-200);
    overflow-wrap: anywhere;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0.6rem 0 1rem;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    color: var(--gray-200);
  }

  .content :global(li) {
    position: relative;
    padding-left: 1rem;
    line-height: 1.7;
  }

  .content :global(li)::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--gray-400);
  }

  .content :global(hr) {
    border: 0;
    height: 1px;
    margin: 1.75rem 0;
    background: color-mix(in srgb, var(--gray-800) 85%, transparent);
  }

  .galleryViewport {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(280px, 1fr);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.25rem;
  }

  .gallerySlide {
    margin: 0;
    scroll-snap-align: start;
  }

  .gallerySlide img {
    width: 100%;
    border-radius: 1rem;
    border: 1px solid var(--gray-800);
    display: block;
  }

  /* Titre de section skills dans la card */
.sideCard .sideTitle {
  letter-spacing: -0.01em;
}
</style>