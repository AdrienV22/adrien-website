---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="CV | Adrien Valo" description="A propos de mon CV">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="Mon CV"

			>
			
			</Hero>

			<section>
				<h2 class="section-title">Présentation <Icon icon="text-presentation" /></h2>
			  
				<div class="content">
				  <p>
					Après 5 années d’expérience en gestion de projets (marketing digital), j’ai choisi de me
					réorienter vers le développement logiciel. Depuis près de deux ans en alternance chez
					ADENTAL GROUP, je conçois et maintiens des solutions orientées back-end, automatisation
					et data, avec une attention particulière portée à la fiabilité et à la qualité d’exécution.
				  </p>
			  			  
				  <ul class="highlights" aria-label="Points clés">
					<li>Automatisation de processus (RPA) et logique métier</li>
					<li>ETL / data : intégration, transformation, fiabilisation</li>
					<li>Back-end : APIs, architecture, bonnes pratiques</li>
				  </ul>
				</div>
			  </section>
			  

			<section>
				<h2 class="section-title">Technologies <Icon icon='outil-logo'/></h2>
				<div class="content">
					<p>• Python • Django • Javascript • Typescript • React • Node.js • HTML5 • CSS3 • Git • PHP & MySQL • MongoDB • Astro • UIPath • SSIS •</p>
				</div>
			</section>
			
			<section>
				<h2 class="section-title">Softskills <Icon icon='boite-outil'/></h2>
				<div class="content">
					<p>• Gestion de projet Agile / Scrum • Coordination et suivi des étapes d’un projet •  Sens de l’organisation  •  Résolution de problèmes • Adaptabilité   • Esprit d’équipe  •  Rigueur • Force de proposition • </p>
				</div>
			</section>

			<section>
				<h2 class="section-title">Hardskills <Icon icon='terminal-window'/></h2>
				<div class="content">
					<p>• Capacité à travailler avec Git pour gérer les versions du code source et faciliter la collaboration <br> • Connaissance des concepts d'architecture logicielle pour la création de systèmes robustes et évolutifs  <br> • Conscience des bonnes pratiques en matière de sécurité informatique et capacité à optimiser les performances des applications  </p>
				</div>
			</section>
			
			<section>
				<h2 class="section-title">
				  Diplômes <Icon icon="diplome-logo" />
				</h2>
			  
				<div class="content diplomas">
				  <div class="diploma">
					<p class="diploma-title">
					  Diplôme d’Expert en Ingénierie Logicielle
					</p>
					<p class="diploma-meta">
					  ISCOD
					</p>
					<p class="diploma-meta">
						2024 - 2026
					  </p>
				  </div>
			  
				  <div class="diploma">
					<p class="diploma-title">
					  Master Cinéma & Audiovisuel — Spécialité Médias
					</p>
					<p class="diploma-meta">
					  Université Sorbonne Nouvelle (Paris)
					</p>
					<p class="diploma-highlight">
						6 mois d’échange international à la Tokyo University of Foreign Studies
						<span>(Tokyo, Japon)</span>
					  </p>
					  
				  </div>
			  
				  <div class="diploma">
					<p class="diploma-title">
					  Japanese Language Proficiency Test — Niveau N2
					</p>
					<p class="diploma-meta">
					  <a href="https://www.jpf.go.jp/e/" target="_blank">The Japan Foundation</a>
					</p>
				  </div>
				</div>
			  </section>
			  

			<section>
				<h2 class="section-title">Centre d'intérêts <Icon icon='loupe-logo'/></h2>
				<div class="content">
					<p>• <Icon icon='language-logo'/> Secrétaire général de l'association d'échanges linguistiques <a href="https://www.gengoffee.fr" target="_blank"> Gengoffee</a> (depuis 2022)</p>
					<p>• <Icon icon='computer-screen'/> Production musicale sur ordinateur (MAO) via Ableton Live 11</p>
					<p>• <Icon icon='guitar-logo'/> Guitariste membre du club de jazz de la Tokyo University of Foreign Studies (Tokyo, Japon)</p>
					<p>• <Icon icon='chess-logo'/> Echecs et résolution de problèmes d'echecs</p>
					<p>• <Icon icon='movie-logo'/> Cinéma de genre (Horreur, Science-fiction, Thriller) </p>
				</div>
			</section>
			
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}

	.highlights {
  margin: 1rem 0 0;
  padding-left: 1.15rem;
  display: grid;
  gap: 0.4rem;

  color: var(--gray-200);
}

.highlights li {
  line-height: 1.5;
}

@media (min-width: 50em) {
  .highlights {
    margin-top: 1.25rem;
  }
}


	.diplomas {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.diploma-title {
  margin: 0;
  font-weight: 500;
  color: var(--gray-0);
}

.diploma-meta {
  margin: 0;
  font-size: var(--text-md);
  color: var(--gray-400);
}

.diploma-detail {
  margin: 0.25rem 0 0;
  font-size: var(--text-sm);
  color: var(--white);
}

.diploma-highlight {
  margin: 0.5rem 0 0;
  padding-left: 0.75rem;

  font-size: var(--text-md);
  font-style: bold;
  font-weight: 500;
  color: var(--gray-200);

  border-left: 2px solid var(--accent-regular);
}

.diploma-highlight span {
  color: var(--gray-400);
  font-weight: 400;
}


</style>
