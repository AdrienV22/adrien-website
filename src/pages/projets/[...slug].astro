---
import { getCollection, getEntryBySlug, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import Icon from "../../components/Icon.astro";
import Pill from "../../components/Pill.astro";

type WorkEntry = CollectionEntry<"work">;
type SkillEntry = CollectionEntry<"skills">;

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({ params: { slug: entry.slug } }));
}

/** [...slug] => string OU string[] */
const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam;

if (!slug) throw new Error("Missing slug param for /projets/[...slug].astro");

const entry = (await getEntryBySlug("work", slug)) as WorkEntry | null;
if (!entry) throw new Error(`Work entry not found for slug: ${slug}`);

const { Content, headings } = await entry.render();
const toc = (headings ?? []).filter((h: any) => h.depth >= 2 && h.depth <= 3);

const type = (entry.data as any)?.type as string | undefined;
const typeLabel =
  type === "projet" ? "Projet" :
  type === "etude" ? "Étude" :
  type === "rpa" ? "Automatisation" :
  type === "dev" ? "Développement" :
  type === "slide" ? "Présentation" :
  type ? "Autre" : null;

const tagline = typeLabel ?? "";

const gallery = (entry.data as any)?.gallery as { src: string; alt?: string }[] | undefined;

const altOf = (item: { alt?: string }, i: number) =>
  (item.alt && String(item.alt).trim()) || `${entry.data.title} — visuel ${i + 1}`;

/** RNCP : compétences liées (slug -> titre) */
const relatedSkillsSlugs = ((entry.data as any)?.relatedSkills ?? []) as string[];
const skills = (await getCollection("skills")) as SkillEntry[];
const skillBySlug = new Map(skills.map((s) => [String(s.slug), s]));
const relatedSkills = relatedSkillsSlugs
  .map((s) => skillBySlug.get(String(s)))
  .filter((x): x is SkillEntry => Boolean(x));

/** ✅ Navigation Précédent / Suivant (tri par date desc) */
const all = (await getCollection("work")) as WorkEntry[];
const sorted = [...all].sort((a, b) => {
  const aDate = (a.data.publishDate as Date | undefined)?.valueOf?.() ?? 0;
  const bDate = (b.data.publishDate as Date | undefined)?.valueOf?.() ?? 0;
  return bDate - aDate;
});
const idx = sorted.findIndex((e) => String(e.slug) === String(entry.slug));
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx >= 0 && idx < sorted.length - 1 ? sorted[idx + 1] : null;

/** ✅ Liens (safe) */
const links = ((entry.data as any)?.links ?? {}) as {
  repo?: string;
  repoFrontend?: string;
  repoBackend?: string;
  demo?: string;
  doc?: string;
};
const hasLinks = Boolean(
  links.repo || links.repoFrontend || links.repoBackend || links.demo || links.doc
);
const hasCodeLinks = Boolean(links.repoFrontend || links.repoBackend);

/** Projets soumis à confidentialité / données de santé (encart d’information) */
const isConfidentialProject = String(entry.slug) === "robots-rpa" || String(entry.slug) === "etl";
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <main class="wrapper stack gap-10" id="top">
    <a class="back" href="/projets/">
      <Icon icon="arrow-left" /> Retour aux réalisations
    </a>

    <Hero title={entry.data.title} tagline={tagline || undefined} align="start">
      {entry.data.description ? <p class="lead">{entry.data.description}</p> : null}
    </Hero>

    {isConfidentialProject ? (
      <aside class="confidentialEncart" role="note" aria-label="Information confidentialité">
        <span class="confidentialEncartIcon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round">
            <path d="M128 48a88 88 0 0 0-88 88c0 30 18 58 44 76v36a8 8 0 0 0 8 8h72a8 8 0 0 0 8-8v-36c26-18 44-46 44-76a88 88 0 0 0-88-88Z"/>
            <path d="M128 152a24 24 0 0 1-24-24v-16a24 24 0 0 1 48 0v16a24 24 0 0 1-24 24Z"/>
          </svg>
        </span>
        <p class="confidentialEncartText">
          Ce projet ne peut pas être montré dans son intégralité afin de protéger la <strong>confidentialité</strong> et les <strong>données de santé</strong>. La fiche présente la démarche, les compétences mobilisées et les résultats sans exposer d’éléments sensibles.
        </p>
      </aside>
    ) : null}

    <section class="layout" aria-label="Fiche projet">
      {/* Colonne principale */}
      <div class="mainCol stack gap-10">
        {/* ✅ Carousel sobre : flèche avant / arrière uniquement */}
        {gallery?.length ? (
          <section class="gallery" aria-label="Galerie">
            <div class="galleryShell" data-gallery>
              <button class="gArrow gPrev" type="button" aria-label="Image précédente" data-prev>
                ‹
              </button>

              <div
                class="galleryViewport"
                tabindex="0"
                aria-label="Galerie (défilement horizontal)"
                data-viewport
              >
                {gallery.map((item, i) => (
                  <figure class="gallerySlide">
                    <img
                      src={item.src}
                      alt={altOf(item, i)}
                      loading={i === 0 ? "eager" : "lazy"}
                      fetchpriority={i === 0 ? "high" : "auto"}
                      decoding="async"
                      sizes="(min-width: 60em) 900px, 100vw"
                    />
                  </figure>
                ))}
              </div>

              <button class="gArrow gNext" type="button" aria-label="Image suivante" data-next>
                ›
              </button>

              {/* fade edges */}
              <span class="edge edgeLeft" aria-hidden="true"></span>
              <span class="edge edgeRight" aria-hidden="true"></span>
            </div>
          </section>
        ) : null}

        {/* Card principale */}
        <section class="card" aria-label="Contenu">
          <article class="content" data-md-blocks>
            <Content />
          </article>
        </section>

        {/* Navigation précédente / suivante */}
        <nav class="pager" aria-label="Navigation entre réalisations">
          {prev ? (
            <a class="pagerLink" href={`/projets/${prev.slug}/`}>
              <span class="pagerLabel">Précédent</span>
              <span class="pagerTitle">{prev.data.title}</span>
            </a>
          ) : <span />}

          {next ? (
            <a class="pagerLink" href={`/projets/${next.slug}/`}>
              <span class="pagerLabel">Suivant</span>
              <span class="pagerTitle">{next.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      </div>

      {/* Colonne droite */}
      <aside class="sideCol" aria-label="Informations">
        <section class="card sideCard">
          <h2 class="sideTitle">Résumé</h2>

          {entry.data.description ? <p class="sideText">{entry.data.description}</p> : null}

          {typeLabel ? (
            <dl class="facts" aria-label="Fiche projet">
              <dt>Nature</dt>
              <dd>{typeLabel}</dd>
            </dl>
          ) : null}

          {entry.data.tags?.length ? (
            <>
              <h3 class="sideSubtitle">Technologies</h3>
              <div class="sideTags">
                {entry.data.tags.map((t) => <Pill>{t}</Pill>)}
              </div>
            </>
          ) : null}

          {hasLinks ? (
            <>
              <h3 class="sideSubtitle">Liens</h3>
              <div class="sideLinks">
                {links.repoFrontend ? (
                  <a class="repoLink" href={links.repoFrontend} target="_blank" rel="noopener noreferrer" aria-label="Voir le code frontend sur GitHub">
                    <Icon icon="github-logo" size="1.1em" />
                    <span>Voir le code frontend</span>
                  </a>
                ) : null}
                {links.repoBackend ? (
                  <a class="repoLink" href={links.repoBackend} target="_blank" rel="noopener noreferrer" aria-label="Voir le code backend sur GitHub">
                    <Icon icon="github-logo" size="1.1em" />
                    <span>Voir le code backend</span>
                  </a>
                ) : null}
                {!hasCodeLinks && links.repo ? (
                  <a class="repoLink" href={links.repo} target="_blank" rel="noopener noreferrer" aria-label="Voir le code sur GitHub">
                    <Icon icon="github-logo" size="1.1em" />
                    <span>Code</span>
                  </a>
                ) : null}
                {links.demo ? (
                  <a class="pillLink" href={links.demo} target="_blank" rel="noopener noreferrer">
                    Démo
                  </a>
                ) : null}
                {links.doc ? (
                  <a class="pillLink" href={links.doc} target="_blank" rel="noopener noreferrer">
                    Documentation
                  </a>
                ) : null}
              </div>
            </>
          ) : null}
        </section>

        {relatedSkills.length ? (
          <section class="card sideCard">
            <h2 class="sideTitle">Compétences mobilisées</h2>
            <div class="skillLinks">
              {relatedSkills.map((s) => (
                <a class="skillPill" href={`/competences/${s.slug}/`}>
                  {s.data.title}
                </a>
              ))}
            </div>
          </section>
        ) : null}

        {toc.length ? (
          <section class="card sideCard tocCard">
            <h2 class="sideTitle">Table des matières</h2>

            <nav class="toc" aria-label="Table des matières">
              <div class="tocPills">
                {toc.map((h: any) => (
                  <a class:list={["tocPill", h.depth === 3 && "isSub"]} href={`#${h.slug}`}>
                    <span class="tocPillText">{h.text}</span>
                  </a>
                ))}
              </div>
            </nav>
          </section>
        ) : null}

        <section class="sideActions" aria-label="Actions">
          <a class="actionPill" href="/projets/">
            <span class="actionText">Toutes les réalisations</span>
            <span class="actionIcon" aria-hidden="true">›</span>
          </a>

          <a class="actionPill" href="#top">
            <span class="actionText">Retour en haut</span>
            <span class="actionIcon" aria-hidden="true">↑</span>
          </a>
        </section>
      </aside>
    </section>

    <ContactCTA />
  </main>
</BaseLayout>

<script is:inline>
  // ✅ JS pur (pas de types) => plus d'erreur ts(8010)
  (() => {
    const shell = document.querySelector("[data-gallery]");
    if (!shell) return;

    const viewport = shell.querySelector("[data-viewport]");
    const prevBtn = shell.querySelector("[data-prev]");
    const nextBtn = shell.querySelector("[data-next]");
    if (!viewport || !prevBtn || !nextBtn) return;

    const scrollByOne = (dir) => {
      const amount = viewport.clientWidth;
      viewport.scrollBy({ left: dir * amount, behavior: "smooth" });
    };

    prevBtn.addEventListener("click", () => scrollByOne(-1));
    nextBtn.addEventListener("click", () => scrollByOne(1));

    viewport.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        scrollByOne(-1);
      }
      if (e.key === "ArrowRight") {
        e.preventDefault();
        scrollByOne(1);
      }
    });
  })();
</script>

<script>
  // ✅ IIFE = pas de "return" au top-level => build Netlify OK
  (() => {
    const root = document.querySelector("[data-md-blocks]");
    if (!root) return;

    const icons = {
      target: `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
          <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
        </svg>
      `,
      tools: `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14 7l3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M13 8l-8 8a2 2 0 0 0 0 3 2 2 0 0 0 3 0l8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M16.5 3.5a4.5 4.5 0 0 0 4 6l-1.8 1.8-4-4L16.5 3.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
      `,
      shield: `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3l8 4v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V7l8-4Z"
            stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
      `,
      chart: `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 19V5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M10 19V9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M16 19V12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M22 19H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      `,
      check: `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
          <path d="M8 12l3 3 5-6"
            stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"/>
        </svg>
      `,
      arrow: `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 17l10-10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M10 7h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      `,
      eye: `
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z"
            stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
        </svg>
      `,
    };

    const iconMap = new Map([
      ["definition", "target"],
      ["mise en pratique", "tools"],
      ["contraintes & enjeux", "shield"],
      ["contraintes et enjeux", "shield"],
      ["resultats", "chart"],
      ["résultats", "chart"],
      ["auto-evaluation", "check"],
      ["auto-évaluation", "check"],
      ["evolution", "arrow"],
      ["évolution", "arrow"],
      ["regard critique", "eye"],
    ]);

    const normalize = (s: string) =>
      s
        .trim()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

    const children = Array.from(root.children);
    let current = null;

    for (const el of children) {
      const isH2 = el.tagName === "H2";

      if (isH2) {
        current = document.createElement("article");
        current.className = "block mdBlock";
        root.insertBefore(current, el);

        const title = el.textContent ?? "";
        const key = normalize(title);
        const iconKey = iconMap.get(key);

        if (iconKey) {
          const iconWrap = document.createElement("span");
          iconWrap.className = "blockIcon";
          iconWrap.setAttribute("aria-hidden", "true");
          iconWrap.innerHTML = icons[iconKey as keyof typeof icons];
          el.prepend(iconWrap);
        }

        current.appendChild(el);
        continue;
      }

      if (current) current.appendChild(el);
    }
  })();
</script>

<style>
  .back {
    width: fit-content;
    color: var(--gray-300);
    text-decoration: none;
    border: 1px solid var(--gray-800);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    background: var(--gray-999_40);
    transition: border-color var(--theme-transition), transform var(--theme-transition);
  }
  .back:hover,
  .back:focus-visible {
    border-color: var(--gray-600);
    transform: translateY(-1px);
    outline: none;
  }

  .lead {
    margin: 0;
    max-width: 78ch;
    color: var(--gray-200);
    line-height: 1.7;
  }

  /* Encart confidentialité / données de santé (projets RPA & ETL) */
  .confidentialEncart {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--accent-regular) 25%, var(--gray-800));
    border-left-width: 3px;
    border-left-color: var(--accent-regular);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent-regular) 8%, var(--gray-999_40)),
      var(--gray-999_40)
    );
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }

  .confidentialEncartIcon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--accent-regular) 15%, transparent);
    color: var(--accent-regular);
  }

  .confidentialEncartIcon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .confidentialEncartText {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--gray-200);
  }

  .confidentialEncartText strong {
    color: var(--gray-100);
    font-weight: 600;
  }

  .layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    min-width: 0;
  }

  @media (min-width: 60em) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 360px;
    }
  }

  .mainCol,
  .sideCol {
    min-width: 0;
  }

  .sideCol {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    position: relative;
    z-index: 0;
  }

  .card {
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 3vw, 1.9rem);
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }

  /* =========================
     Carousel sobre + premium
  ========================= */
  .gallery {
    display: grid;
    gap: 0.85rem;
  }

  .galleryShell {
    position: relative;
    border-radius: 1.5rem;
    border: 1px solid var(--gray-800);
    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .galleryViewport {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 1rem;
    padding: 1rem;
    -webkit-overflow-scrolling: touch;
  }

  .galleryViewport:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
    border-radius: 1.25rem;
  }

  .gallerySlide {
    margin: 0;
    scroll-snap-align: start;
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--gray-800);
    background: var(--gray-999_40);
    aspect-ratio: 16 / 9;
  }

  .gallerySlide img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1);
    transition: transform var(--theme-transition);
  }

  .gallerySlide:hover img {
    transform: scale(1.01);
  }

  .gArrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;

    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--gray-800) 82%, transparent);
    background:
      linear-gradient(180deg, var(--gray-999_40), transparent),
      radial-gradient(var(--gray-900), var(--gray-800) 150%);
    color: var(--gray-0);
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);

    display: grid;
    place-items: center;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;

    transition:
      transform var(--theme-transition),
      border-color var(--theme-transition),
      box-shadow var(--theme-transition),
      color var(--theme-transition);
  }

  .gArrow:hover,
  .gArrow:focus-visible {
    outline: none;
    border-color: color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700));
    box-shadow:
      0 18px 45px rgba(0, 0, 0, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    transform: translateY(-50%) translateY(-1px);
  }

  .gPrev { left: 0.75rem; }
  .gNext { right: 0.75rem; }

  .edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 56px;
    pointer-events: none;
    opacity: 0.85;
  }

  .edgeLeft {
    left: 0;
    background: linear-gradient(to right, var(--gray-999), transparent);
  }

  .edgeRight {
    right: 0;
    background: linear-gradient(to left, var(--gray-999), transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallerySlide img,
    .gArrow {
      transition: none;
    }
  }

  /* CONTENT — blocks premium */
  .content {
    display: grid;
    gap: 1.25rem;
    max-width: 78ch;
    min-width: 0;
  }

  .content :global(.mdBlock) {
    position: relative;
    border: 1px solid var(--gray-800);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform var(--theme-transition),
      box-shadow var(--theme-transition),
      border-color var(--theme-transition);
  }

  .content :global(.mdBlock::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 14%;
    bottom: 14%;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 18%,
      var(--accent-regular) 50%,
      color-mix(in srgb, var(--accent-regular) 35%, var(--gray-700)) 82%,
      transparent 100%
    );
    opacity: 0.7;
  }

  .content :global(.mdBlock:hover),
  .content :global(.mdBlock:focus-within) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-overlay);
    outline: none;
  }

  .content :global(.mdBlock > h2) {
    margin: 0 0 0.75rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    letter-spacing: -0.02em;
    color: var(--gray-0);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .content :global(.blockIcon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    color: color-mix(in srgb, var(--accent-regular) 55%, var(--gray-200));
    opacity: 0.95;
    transform: translateY(0.5px);
  }

  .content :global(.blockIcon svg) {
