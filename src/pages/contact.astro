---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Contact | Adrien Valo" description="Me contacter">
  <div class="stack gap-20">
    <main class="wrapper contact stack gap-10">
      <Hero
        title="Contact"
        tagline="Contactez-moi pour toute demande de collaboration ou de renseignements."
        align="start"
      />

      <section class="contact-section">
        <form
          class="form"
          name="contact"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
        >
          <!-- requis pour Netlify -->
          <input type="hidden" name="form-name" value="contact" />

          <!-- honeypot anti-spam -->
          <p class="sr-only">
            <label>
              Ne pas remplir si vous êtes humain :
              <input name="bot-field" />
            </label>
          </p>

          <div class="grid">
            <label class="field">
              <span class="label">Nom</span>
              <input
                name="name"
                type="text"
                autocomplete="name"
                placeholder="Votre nom"
                required
              />
            </label>

            <label class="field">
              <span class="label">Email</span>
              <input
                name="email"
                type="email"
                autocomplete="email"
                placeholder="vous@exemple.com"
                required
              />
            </label>
          </div>

          <label class="field">
            <span class="label">Sujet</span>
            <input
              name="subject"
              type="text"
              placeholder="Objet de votre message"
              required
            />
          </label>

          <label class="field">
            <span class="label">Message</span>
            <textarea
              name="message"
              rows="7"
              placeholder="Écrivez votre message…"
              required
            ></textarea>
          </label>

          <button class="submit" type="submit">
            Envoyer
            <Icon icon="paper-plane-tilt" size="1.2em" />
          </button>
<!-- 
          <p class="hint">
            Ou par email :
            <a href="mailto:">ad</a>
          </p> -->
        </form>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .contact {
    display: flex;
    flex-direction: column;
  }

  .contact-section {
    display: grid;
  }

  .form {
    width: 100%;
    max-width: 56rem;

    border: 1px solid var(--gray-800);
    border-radius: 1.25rem;
    padding: 1.25rem;

    background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
    box-shadow: var(--shadow-md);
  }

  .grid {
    display: grid;
    gap: 0.9rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  .label {
    font-size: var(--text-sm);
    color: var(--gray-300);
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border-radius: 0.95rem;

    border: 1px solid var(--gray-800);
    background: var(--gray-999_40);
    color: var(--gray-0);

    outline: none;

    transition:
      border-color var(--theme-transition),
      box-shadow var(--theme-transition),
      background-color var(--theme-transition);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--gray-400);
  }

  input:focus,
  textarea:focus {
    border-color: var(--accent-overlay);
    box-shadow: 0 0 0 4px var(--accent-subtle-overlay);
  }

  .submit {
    margin-top: 1rem;

    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    padding: 0.7rem 1.1rem;
    border-radius: 999px;

    border: 1px solid var(--accent-regular);
    background: var(--accent-regular);
    color: var(--accent-text-over);

    cursor: pointer;
    box-shadow: var(--shadow-sm);

    transition:
      transform var(--theme-transition),
      box-shadow var(--theme-transition),
      border-color var(--theme-transition);
  }

  .submit:hover,
  .submit:focus-visible {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-overlay);
    outline: none;
  }

  .hint {
    margin: 0.9rem 0 0;
    color: var(--gray-300);
    font-size: var(--text-sm);
  }

  .hint a {
    color: var(--gray-0);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .hint a:hover,
  .hint a:focus {
    text-decoration-color: currentColor;
  }

  @media (min-width: 50em) {
    .form {
      padding: 1.75rem;
    }

    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
